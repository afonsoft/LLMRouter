@page "/error/{Code:int}"
@page "/400"
@page "/401"
@page "/403"
@page "/408"
@page "/429"
@page "/500"
@page "/502"
@page "/503"
@layout AuthLayout
@inject Loc Loc
@inject NavigationManager Nav

<div style="text-align:center;padding:80px 20px">
    <span class="material-symbols-outlined" style="font-size:56px;color:var(--primary)">@Icon</span>
    <h1 style="font-size:40px;margin:10px 0 4px">@EffectiveCode</h1>
    <p class="page-desc">@Message</p>
    <a class="btn btn-primary" style="margin-top:18px" href="/">@Loc.T("error.home", "Back home")</a>
</div>

@code {
    [Parameter] public int Code { get; set; }

    private int EffectiveCode => Code != 0 ? Code : Nav.Uri.Split('/').Last() switch
    {
        "400" => 400, "401" => 401, "403" => 403, "408" => 408,
        "429" => 429, "500" => 500, "502" => 502, "503" => 503, _ => 404,
    };

    private string Icon => EffectiveCode switch
    {
        401 or 403 => "lock", 429 => "speed", 408 => "schedule",
        >= 500 => "cloud_off", _ => "error",
    };

    private string Message => Loc.T($"error.{EffectiveCode}", EffectiveCode switch
    {
        400 => "Bad request", 401 => "Sign in required", 403 => "Access denied",
        404 => "Page not found", 408 => "Request timed out", 429 => "Rate limited",
        502 => "Upstream unavailable", 503 => "Service unavailable", _ => "Something went wrong",
    });
}
