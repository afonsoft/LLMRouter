@page "/dashboard/providers/new"
@page "/dashboard/providers/services/{P}/embed/{*Rest}"
@page "/dashboard/plugins/{Id}/config"
@page "/dashboard/cli-agents/{Id}"
@page "/dashboard/cli-code/{Id}"
@page "/dashboard/radar/combos"
@page "/dashboard/radar/intel"
@page "/dashboard/radar/offers"
@page "/dashboard/radar/setup"
@page "/dashboard/compression"
@page "/dashboard/compression/live"
@page "/dashboard/context"
@page "/dashboard/logs/activity"
@inject Api Api
@inject NavigationManager Nav

@{
    var u = Nav.Uri;
    if (u.EndsWith("/providers/new"))
    {
        <h1 class="page-title">Add provider</h1>
        <p class="page-desc">Deep-linkable provider creation</p>
        <div class="card card-p mt-4" style="max-width:480px">
            <input class="input" @bind="_providerName" placeholder="provider id (e.g. openai)" />
            <input class="input mt-2" @bind="_providerKey" placeholder="API key" type="password" />
            <button class="btn btn-sm mt-3" @onclick="CreateProvider">Create</button>
            @if (_created) { <p class="mt-2">Created — <a href="/dashboard/providers">open providers</a>.</p> }
        </div>
    }
    else if (u.Contains("/services/") && u.Contains("/embed"))
    {
        <h1 class="page-title">Service: @P</h1>
        <div class="card card-p mt-4">
            <p>Embedded view of the service UI (auth handoff via session cookie).</p>
            <iframe src="/api/services/@P/ui/@Rest" style="width:100%;height:480px;border:1px solid var(--border);border-radius:8px" title="service embed"></iframe>
        </div>
    }
    else if (u.Contains("/plugins/") && u.EndsWith("/config"))
    {
        <h1 class="page-title">Plugin config: @Id</h1>
        <div class="card card-p mt-4">
            <textarea class="input" rows="10" @bind="_json" style="font-family:monospace"></textarea>
            <button class="btn btn-sm mt-2" @onclick="SavePluginConfig">Save</button>
        </div>
    }
    else if (u.Contains("/cli-agents/") || u.Contains("/cli-code/"))
    {
        var kind = u.Contains("/cli-agents/") ? "cliAgents" : "cliTools";
        <h1 class="page-title">@kind — @Id</h1>
        <div class="card card-p mt-4">
            @if (_data.ValueKind == JsonValueKind.Undefined) { <p>Loading…</p> }
            else { <pre style="max-height:420px;overflow:auto">@JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true })</pre> }
        </div>
    }
    else if (u.Contains("/radar/"))
    {
        var sub = u.Split("/radar/")[1];
        <h1 class="page-title">Radar — @sub</h1>
        <div class="card card-p mt-4">
            @if (_data.ValueKind == JsonValueKind.Undefined) { <p>Loading…</p> }
            else { <pre style="max-height:420px;overflow:auto">@JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true })</pre> }
        </div>
    }
    else if (u.EndsWith("/compression/live"))
    {
        <h1 class="page-title">Compression — live preview</h1>
        <div class="card card-p mt-4">
            <textarea class="input" rows="6" @bind="_json" placeholder="text to compress"></textarea>
            <button class="btn btn-sm mt-2" @onclick="RunLive">Compress</button>
            @if (_data.ValueKind != JsonValueKind.Undefined)
            { <pre class="mt-3" style="max-height:300px;overflow:auto">@JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true })</pre> }
        </div>
    }
    else if (u.EndsWith("/compression"))
    {
        <h1 class="page-title">Compression</h1>
        <div class="grid gap-3 mt-4" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))">
            <a class="card card-p" href="/dashboard/compression/studio">Studio</a>
            <a class="card card-p" href="/dashboard/compression/exclusions">Exclusions</a>
            <a class="card card-p" href="/dashboard/compression/live">Live preview</a>
            <a class="card card-p" href="/dashboard/analytics/compression">Analytics</a>
        </div>
    }
    else if (u.EndsWith("/logs/activity"))
    {
        <h1 class="page-title">Activity</h1>
        <div class="card card-p mt-4">
            <p>Audit events + usage activity — same data as <a href="/dashboard/activity">/dashboard/activity</a>.</p>
            @if (_data.ValueKind == JsonValueKind.Undefined) { <p>Loading…</p> }
            else { <pre style="max-height:420px;overflow:auto">@JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true })</pre> }
        </div>
    }
    else
    {
        <h1 class="page-title">Context</h1>
        <div class="grid gap-3 mt-4" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))">
            <a class="card card-p" href="/dashboard/context/combos">Combos</a>
            <a class="card card-p" href="/dashboard/context/settings">Settings</a>
            <a class="card card-p" href="/dashboard/context/ccr">CCR engine</a>
            <a class="card card-p" href="/dashboard/analytics">Analytics</a>
        </div>
    }
}

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? P { get; set; }
    [Parameter] public string? Rest { get; set; }

    private JsonElement _data;
    private string _providerName = "";
    private string _providerKey = "";
    private string _json = "{}";
    private bool _created;

    protected override async Task OnInitializedAsync()
    {
        var u = Nav.Uri;
        if (u.Contains("/plugins/") && u.EndsWith("/config"))
            _json = (await Api.GetAsync($"/api/plugins/{Id}/config")).GetRawText();
        else if (u.Contains("/cli-agents/"))
            _data = await Api.GetAsync($"/api/cli/agents/{Id}");
        else if (u.Contains("/cli-code/"))
            _data = await Api.GetAsync($"/api/cli/tools/{Id}");
        else if (u.Contains("/radar/"))
            _data = await Api.GetAsync($"/api/radar/{u.Split("/radar/")[1]}");
        else if (u.EndsWith("/logs/activity"))
            _data = await Api.GetAsync("/api/activity");
    }

    private async Task CreateProvider()
    {
        await Api.PostAsync("/api/provider-connections",
            new { provider = _providerName, apiKey = _providerKey, isActive = true });
        _created = true;
    }

    private async Task SavePluginConfig() =>
        await Api.PutAsync($"/api/plugins/{Id}/config", JsonSerializer.Deserialize<JsonElement>(_json));

    private async Task RunLive() =>
        _data = await Api.PostAsync("/api/compression/run", new { text = _json });
}
