@page "/dashboard/cli-tools"
@page "/dashboard/cli-code"
@page "/dashboard/cli-agents"
@inject Api Api
@inject Loc Loc

<h1 class="page-title">@Loc.T("cliTools.title", "CLI tools")</h1>
<p class="page-desc">@Loc.T("cliTools.subtitle", "Point any coding CLI at this router — copy the env block for your tool")</p>

@if (_tools is null)
{
    <p class="muted">…</p>
}
else
{
    <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:12px">
        @foreach (var t in _tools)
        {
            var detected = t.GetProperty("detected").GetBoolean();
            var id = t.GetProperty("id").GetString()!;
            <div class="card card-p">
                <div class="flex between" style="margin-bottom:8px">
                    <h3 class="bold" style="margin:0">@t.GetProperty("name").GetString()</h3>
                    <span class="badge @(detected ? "ok" : "muted")">@(detected ? Loc.T("cliTools.detected", "detected") : Loc.T("cliTools.notDetected", "not found"))</span>
                </div>
                <p class="muted" style="font-size:12px;margin:0 0 8px">@t.GetProperty("installHint").GetString()</p>
                <pre class="code-block" style="font-size:11px;max-height:140px;overflow:auto">@EnvBlock(t)</pre>
                <button class="btn btn-sm" style="margin-top:8px" @onclick='() => Copy(EnvBlock(t))'>@Loc.T("common.copy", "Copy")</button>
            </div>
        }
    </div>
    <div class="mt-4"><CliImportCard /></div>

    <h2 class="bold" style="margin-top:32px">@Loc.T("vscodeTokens.title", "VSCode tokens")</h2>
    <p class="page-desc">@Loc.T("vscodeTokens.subtitle", "Tokens for VSCode extensions (Continue, Cline) — point the extension's Ollama/OpenAI provider at the URLs below")</p>
    <div class="card card-p" style="margin-bottom:12px">
        <div class="flex" style="gap:8px;flex-wrap:wrap">
            <input class="input" placeholder="name" @bind="_vscName" style="max-width:220px" />
            <input class="input" placeholder="default combo (optional)" @bind="_vscCombo" style="max-width:220px" />
            <input class="input" placeholder="allowed combos, csv (optional)" @bind="_vscAllowed" style="max-width:260px" />
            <button class="btn" @onclick="CreateVsc">@Loc.T("common.create", "Create")</button>
        </div>
        @if (_vscNewToken is not null)
        {
            <div style="margin-top:12px;padding:10px;border:1px solid var(--border);border-radius:8px">
                <div class="flex between"><b>base URL (Ollama)</b><button class="btn btn-sm" @onclick='() => Copy(_vscNewToken!)'>@Loc.T("common.copy", "Copy")</button></div>
                <code style="font-size:12px">/v1/vscode/@_vscNewToken</code>
                <p class="muted" style="font-size:12px;margin:6px 0 0">@Loc.T("vscodeTokens.revealOnce", "Shown once — save it now.")</p>
            </div>
        }
    </div>
    @if (_vscTokens is { Length: > 0 })
    {
        <table class="table" style="font-size:13px">
            <thead><tr><th>name</th><th>token</th><th>default combo</th><th>allowed</th><th></th></tr></thead>
            <tbody>
                @foreach (var v in _vscTokens)
                {
                    <tr>
                        <td>@(v.TryGetProperty("name", out var vn) && vn.ValueKind == JsonValueKind.String ? vn.GetString() : "—")</td>
                        <td><code>@v.GetProperty("token").GetString()</code></td>
                        <td>@(v.TryGetProperty("defaultCombo", out var dc) && dc.ValueKind == JsonValueKind.String ? dc.GetString() : "—")</td>
                        <td>@(v.GetProperty("allowedCombos").GetArrayLength() == 0 ? Loc.T("common.all", "all") : string.Join(", ", v.GetProperty("allowedCombos").EnumerateArray().Select(e => e.GetString())))</td>
                        <td><button class="btn btn-sm btn-danger" @onclick='() => DelVsc(v.GetProperty("id").GetString()!)'>@Loc.T("common.delete", "Delete")</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private JsonElement[]? _tools;
    [Inject] private IJSRuntime Js { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var r = await Api.GetAsync("api/cli-tools");
        if (r.TryGetProperty("tools", out var arr)) _tools = arr.EnumerateArray().ToArray();
        else _tools = [];
        await LoadVsc();
    }

    private JsonElement[]? _vscTokens;
    private string _vscName = "", _vscCombo = "", _vscAllowed = "";
    private string? _vscNewToken;

    private async Task LoadVsc()
    {
        var r = await Api.GetAsync("api/vscode-tokens");
        if (r.TryGetProperty("tokens", out var arr)) _vscTokens = arr.EnumerateArray().ToArray();
        else _vscTokens = [];
    }

    private async Task CreateVsc()
    {
        var body = new Dictionary<string, object?>();
        if (!string.IsNullOrWhiteSpace(_vscName)) body["name"] = _vscName;
        if (!string.IsNullOrWhiteSpace(_vscCombo)) body["defaultCombo"] = _vscCombo;
        if (!string.IsNullOrWhiteSpace(_vscAllowed))
            body["allowedCombos"] = _vscAllowed.Split(',').Select(s => s.Trim()).Where(s => s.Length > 0).ToArray();
        var r = await Api.PostAsync("api/vscode-tokens", body);
        if (r.TryGetProperty("token", out var tk)) _vscNewToken = tk.GetString();
        _vscName = _vscCombo = _vscAllowed = "";
        await LoadVsc();
    }

    private async Task DelVsc(string id) { await Api.DeleteAsync($"api/vscode-tokens/{id}"); await LoadVsc(); }

    private static string EnvBlock(JsonElement t) =>
        string.Join('\n', t.GetProperty("env").EnumerateObject().Select(kv => $"export {kv.Name}=\"{kv.Value.GetString()}\""));

    private async Task Copy(string s) => await Js.InvokeVoidAsync("navigator.clipboard.writeText", s);
}
