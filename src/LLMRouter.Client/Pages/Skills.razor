@page "/dashboard/omni-skills"
@page "/dashboard/agent-skills"
@page "/dashboard/skills"
@inject Api Api
@inject Loc Loc

<h1 class="page-title">@Loc.T("skills.title", "Skills")</h1>
<p class="page-desc">@Loc.T("skills.subtitle", "Bundled and installed agent skills — SKILL.md modules that extend the router")</p>

<div class="card card-p" style="margin-bottom:14px">
    <div class="flex" style="gap:8px">
        <input class="input" style="flex:1" @bind="_installUrl" placeholder="https://github.com/org/repo/blob/main/path/SKILL.md" />
        <button class="btn btn-primary btn-sm" @onclick="Install" disabled="@(string.IsNullOrWhiteSpace(_installUrl))">@Loc.T("skills.install", "Install from GitHub")</button>
    </div>
    @if (_installMsg is not null) { <p class="muted" style="margin:8px 0 0">@_installMsg</p> }
</div>

@if (_skills is null)
{
    <p class="muted">…</p>
}
else if (_skills.Length == 0)
{
    <div class="card card-p"><p class="muted">@Loc.T("skills.empty", "No skills installed — the skills/ directory ships bundled ones at runtime")</p></div>
}
else
{
    <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:12px">
        @foreach (var s in _skills)
        {
            var enabled = s.GetProperty("enabled").GetBoolean();
            <div class="card card-p">
                <div class="flex between" style="margin-bottom:6px">
                    <h3 class="bold" style="margin:0">@s.GetProperty("name").GetString()</h3>
                    <span class="badge @(enabled ? "ok" : "muted")">@(enabled ? "on" : "off")</span>
                </div>
                <p class="muted" style="font-size:12px;min-height:32px">@s.GetProperty("description").GetString()</p>
                <div class="flex" style="gap:8px;margin-top:8px">
                    <span class="badge muted">@s.GetProperty("source").GetString()</span>
                    <button class="btn btn-sm" @onclick='() => Toggle(s.GetProperty("name").GetString()!)'>@(enabled ? Loc.T("common.disable", "Disable") : Loc.T("common.enable", "Enable"))</button>
                </div>
            </div>
        }
    </div>
}

@code {
    private JsonElement[]? _skills;
    private string _installUrl = "";
    private string? _installMsg;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        var r = await Api.GetAsync("api/skills");
        _skills = r.TryGetProperty("skills", out var arr) ? arr.EnumerateArray().ToArray() : [];
    }

    private async Task Toggle(string name)
    {
        await Api.PostAsync($"api/skills/{Uri.EscapeDataString(name)}/toggle", new { });
        await Load();
    }

    private async Task Install()
    {
        _installMsg = null;
        var r = await Api.Raw.PostAsJsonAsync("api/skills/install", new { url = _installUrl });
        _installMsg = r.IsSuccessStatusCode ? Loc.T("skills.installed", "Installed") : $"error: {await r.Content.ReadAsStringAsync()}";
        _installUrl = "";
        await Load();
    }
}
