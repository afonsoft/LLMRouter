@page "/dashboard/logs"
@inject Api Api
@inject Loc Loc
@inject NavigationManager Nav
@implements IAsyncDisposable

<div class="flex between">
    <div>
        <h1 class="page-title">@Loc.T("logs.title", "Request logs")</h1>
        <p class="page-desc">@Loc.T("logs.subtitle", "Every request through the gateway")</p>
    </div>
    <div class="flex gap-2" style="align-items:center">
        <label class="flex muted sm" style="gap:6px;align-items:center">
            <input type="checkbox" checked="@_recording" @onchange="ToggleRecording" />
            @Loc.T("logs.recording", "Recording")
        </label>
        <label class="flex muted sm" style="gap:6px;align-items:center" title="@Loc.T("logs.ioLoggingHint", "Store request/response payloads (OpenRouter-style Input & Output logging)")">
            <input type="checkbox" checked="@_ioLogging" @onchange="ToggleIoLogging" />
            @Loc.T("logs.ioLogging", "I/O logging")
        </label>
        <a class="btn btn-sm" href="/api/log-export?fmt=csv" target="_blank">CSV</a>
        <a class="btn btn-sm" href="/api/log-export" target="_blank">JSONL</a>
        <button class="btn btn-sm" @onclick="Clean">@Loc.T("logs.cleanHistoryButton", "Clean history")</button>
        <button class="btn btn-sm" @onclick="Load"><span class="material-symbols-outlined" style="font-size:15px">refresh</span>@Loc.T("logs.refresh", "Refresh")</button>
        <CopyLinkButton />
    </div>
</div>

@if (!_recording)
{
    <div class="card card-p mt-4" style="border-left:3px solid var(--warn,#e6a23c)">
        <span class="sm">@Loc.T("logs.paused", "Request capture paused — usage accounting still records.")</span>
    </div>
}

<div class="card card-p mt-4">
    <div class="flex gap-2" style="flex-wrap:wrap;align-items:center">
        <input class="input" style="max-width:220px" placeholder="@Loc.T("logs.searchPlaceholder", "Search model, provider, key, correlation…")"
               @bind="_q" @bind:after="Load" />
        <input class="input mono" style="max-width:180px" placeholder="correlation id" @bind="_rid" @bind:after="Load" />
        <select class="input" style="width:auto" @bind="_model" @bind:after="Load">
            <option value="">All models</option>
            @foreach (var m in _meta.Models) { <option value="@m">@m</option> }
        </select>
        <select class="input" style="width:auto" @bind="_conn" @bind:after="Load">
            <option value="">All accounts</option>
            @foreach (var c in _meta.Accounts) { <option value="@c">@c</option> }
        </select>
        <select class="input" style="width:auto" @bind="_key" @bind:after="Load">
            <option value="">All API keys</option>
            @foreach (var k in _meta.Keys) { <option value="@k">@Mask(k)</option> }
        </select>
        <select class="input" style="width:auto" @bind="_status" @bind:after="Load">
            <option value="">All status</option>
            <option value="200">200</option><option value="4xx">4xx</option><option value="5xx">5xx</option><option value="err">errors</option>
        </select>
        <select class="input" style="width:auto" @bind="_preset" @bind:after="Load">
            <option value="">All time</option>
            <option value="1h">1h</option><option value="1d">1D</option><option value="7d">7D</option><option value="30d">30D</option>
        </select>
        <select class="input" style="width:auto" title="saved views" @bind="_viewId" @bind:after="ApplyView">
            <option value="">@Loc.T("logs.views", "Views")</option>
            @foreach (var v in _views) { <option value="@v.id">@v.name</option> }
        </select>
        <button class="btn ghost sm" title="@Loc.T("logs.saveView", "Save current filters as view")" @onclick="SaveView">
            <span class="material-symbols-outlined" style="font-size:15px">bookmark_add</span>
        </button>
        <label class="flex muted sm" style="gap:6px;align-items:center">
            <input type="checkbox" checked="@_live" @onchange="ToggleLive" /> @Loc.T("logs.live", "live")
        </label>
    </div>
    @if (_meta.Providers.Count > 0)
    {
        <div class="flex gap-2 mt-2" style="flex-wrap:wrap">
            @foreach (var p in _meta.Providers)
            {
                <button class="chip @(_providers.Contains(p) ? "on" : "")" @onclick="() => ToggleProvider(p)">@p@FacetCount("providers", p)</button>
            }
        </div>
    }
</div>

<div class="card mt-4 scroll-x">
    <table class="table">
        <thead><tr>
            <th>@Loc.T("logs.status", "STATUS")</th><th>@Loc.T("logs.time", "LOGGED")</th><th>@Loc.T("models.model", "MODEL")</th>
            <th>@Loc.T("providers.provider", "PROVIDER")</th><th>@Loc.T("logs.type", "REQUEST TYPE")</th>
            <th>@Loc.T("logs.apiKey", "API KEY")</th><th>@Loc.T("logs.latency", "LATENCY")</th><th></th>
        </tr></thead>
        <tbody>
            @foreach (var l in _logs)
            {
                <tr>
                    <td><span class="badge @StatusClass(l.Status)">@l.Status</span></td>
                    <td class="muted sm mono">@l.At</td>
                    <td class="mono sm">@l.Model</td>
                    <td class="mono sm">@l.Provider</td>
                    <td class="sm muted">@(l.Type ?? "—")</td>
                    <td class="mono sm">@Mask(l.Key)</td>
                    <td class="sm muted">@l.LatencyMs ms</td>
                    <td><button class="btn btn-sm" @onclick="() => Toggle(l)">@(_detail?.Id == l.Id ? "Hide" : "Detail")</button></td>
                </tr>
                @if (_detail?.Id == l.Id)
                {
                    <tr><td colspan="8">
                        <div class="card" style="background:var(--bg-subtle)">
                            @if (_gen is not null)
                            {
                                <div class="flex gap-4 mb-2" style="flex-wrap:wrap">
                                    <span class="sm muted">Cost <b class="mono">$@_gen.Value.cost.ToString("0.0000")</b></span>
                                    <span class="sm muted">Tokens <b class="mono">@_gen.Value.pt + @_gen.Value.ct</b></span>
                                    <span class="sm muted">Endpoint <b class="mono">@(_gen.Value.endpoint ?? "—")</b></span>
                                    @if (_gen.Value.corr is not null)
                                    {
                                        <span class="sm muted">corr <b class="mono">@_gen.Value.corr</b></span>
                                    }
                                </div>
                                @if (_gen.Value.attempts.Length > 0)
                                {
                                    <div class="bold sm mb-1">Provider Responses</div>
                                    <table class="table">
                                        <thead><tr><th>#</th><th>Provider</th><th>Status</th><th>Level</th><th>Latency</th><th>TTFB</th><th>Error</th></tr></thead>
                                        <tbody>
                                            @foreach (var a in _gen.Value.attempts)
                                            {
                                                <tr>
                                                    <td class="mono sm">@a.attempt</td>
                                                    <td class="mono sm">@a.provider</td>
                                                    <td><span class="badge @StatusClass(a.status)">@(a.status ?? "—")</span></td>
                                                    <td class="sm muted">@a.level</td>
                                                    <td class="mono sm">@a.latency ms</td>
                                                    <td class="mono sm">@(a.ttfb?.ToString() ?? "—") ms</td>
                                                    <td class="sm muted">@(a.error ?? "—")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            }
                            <div class="bold sm mb-1 mt-2">Raw</div>
                            <pre class="code" style="max-height:300px;overflow:auto">@_detailJson</pre>
                        </div>
                    </td></tr>
                }
            }
            @if (_logs.Count == 0)
            {
                <tr><td colspan="8"><div class="empty"><span class="material-symbols-outlined">receipt_long</span>@Loc.T("logs.empty", "No requests logged")</div></td></tr>
            }
        </tbody>
    </table>
</div>
<div class="flex between mt-2">
    <span class="muted sm">@_logs.Count of @_total</span>
    @if (_logs.Count < _total)
    {
        <button class="btn btn-sm" @onclick="More">@Loc.T("consoleMore", "See more logs")</button>
    }
</div>

@code {
    private record L(long Id, string At, string? Provider, string? Model, string? Status,
        string? Type, string? Key, string? Conn, long LatencyMs);
    private record Meta(List<string> Providers, List<string> Models, List<string> Keys,
        List<string> Types, List<string> Accounts);

    private List<L> _logs = [];
    private L? _detail;
    private string _detailJson = "";
    private (decimal cost, int pt, int ct, string? endpoint, string? corr,
        (int attempt, string? provider, string? status, string? level, long latency, long? ttfb, string? error)[] attempts)? _gen;
    private Meta _meta = new([], [], [], [], []);
    private HashSet<string> _providers = new(StringComparer.OrdinalIgnoreCase);
    private string _q = "", _rid = "", _model = "", _conn = "", _key = "", _status = "", _preset = "";
    private int _total, _limit = 100;
    private bool _recording = true;
    private bool _ioLogging;
    // SPEC-148: saved views + facets + live tail
    private List<(string id, string name, JsonElement filters)> _views = [];
    private string _viewId = "";
    private Dictionary<string, Dictionary<string, int>> _facets = new();
    private bool _live;
    private PeriodicTimer? _liveTimer;
    private CancellationTokenSource? _liveCts;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var s = await Api.GetAsync("api/settings");
            _recording = !s.TryGetProperty("requestLogging", out var rl) || rl.ValueKind != JsonValueKind.False;
            _ioLogging = s.TryGetProperty("observability", out var obs) && obs.ValueKind == JsonValueKind.Object
                && obs.TryGetProperty("ioLogging", out var iol) && iol.ValueKind == JsonValueKind.True;
        }
        catch { }
        try
        {
            var m = await Api.GetAsync("api/usage/call-logs/meta");
            _meta = new Meta(
                Strings(m, "providers"), Strings(m, "models"), Strings(m, "keys"),
                Strings(m, "types"), Strings(m, "accounts"));
        }
        catch { }
        // SPEC-148: filtros espelhados na URL (?model=&status=&provider=&q=)
        try
        {
            var uri = new Uri(Nav.Uri);
            var qp = System.Web.HttpUtility.ParseQueryString(uri.Query);
            if (!string.IsNullOrEmpty(qp["model"])) _model = qp["model"]!;
            if (!string.IsNullOrEmpty(qp["status"])) _status = qp["status"]!;
            if (!string.IsNullOrEmpty(qp["q"])) _q = qp["q"]!;
            if (!string.IsNullOrEmpty(qp["provider"]))
                foreach (var p in qp["provider"]!.Split(',', StringSplitOptions.RemoveEmptyEntries))
                    _providers.Add(p);
        }
        catch { }
        await LoadViews();
        await LoadFacets();
        await Load();
    }

    private async Task LoadViews()
    {
        try
        {
            var r = await Api.GetAsync("api/logs/views");
            _views = r.GetProperty("views").EnumerateArray()
                .Where(v => v.ValueKind == JsonValueKind.Object)
                .Select(v => (v.GetProperty("id").GetString() ?? "",
                    v.GetProperty("name").GetString() ?? "",
                    v.GetProperty("filters").Clone()))
                .ToList();
        }
        catch { }
    }

    private async Task LoadFacets()
    {
        try
        {
            var r = await Api.GetAsync("api/logs/facets");
            _facets = new();
            foreach (var grp in new[] { "providers", "models", "statuses" })
                if (r.TryGetProperty(grp, out var g))
                    _facets[grp] = g.EnumerateObject().ToDictionary(p => p.Name, p => p.Value.GetInt32());
        }
        catch { }
    }

    private string FacetCount(string grp, string name) =>
        _facets.TryGetValue(grp, out var g) && g.TryGetValue(name, out var n) ? $" ({n})" : "";

    private async Task ApplyView()
    {
        var v = _views.FirstOrDefault(x => x.id == _viewId);
        if (v.id is null) return;
        var f = v.filters;
        _q = S(f, "q"); _rid = S(f, "rid"); _model = S(f, "model");
        _conn = S(f, "conn"); _key = S(f, "key"); _status = S(f, "status"); _preset = S(f, "preset");
        _providers = f.TryGetProperty("providers", out var ps) && ps.ValueKind == JsonValueKind.Array
            ? new HashSet<string>(ps.EnumerateArray().Select(x => x.GetString() ?? ""), StringComparer.OrdinalIgnoreCase)
            : new(StringComparer.OrdinalIgnoreCase);
        await Load();
        static string S(JsonElement f, string k) =>
            f.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";
    }

    private async Task SaveView()
    {
        var name = $"view {_views.Count + 1}";
        await Api.PostAsync("api/logs/views", new
        {
            name,
            filters = new { q = _q, rid = _rid, model = _model, conn = _conn, key = _key,
                status = _status, preset = _preset, providers = _providers.ToArray() },
        });
        await LoadViews();
    }

    private async Task ToggleLive(ChangeEventArgs e)
    {
        _live = e.Value is bool b && b;
        _liveCts?.Cancel();
        if (!_live) return;
        _liveCts = new();
        _liveTimer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        _ = Task.Run(async () =>
        {
            try
            {
                while (await _liveTimer.WaitForNextTickAsync(_liveCts.Token))
                    await InvokeAsync(async () => { await Load(); StateHasChanged(); });
            }
            catch (OperationCanceledException) { }
        });
    }

    public ValueTask DisposeAsync()
    {
        _liveCts?.Cancel();
        _liveTimer?.Dispose();
        return ValueTask.CompletedTask;
    }

    private static List<string> Strings(JsonElement e, string prop) =>
        e.TryGetProperty(prop, out var a) && a.ValueKind == JsonValueKind.Array
            ? a.EnumerateArray().Select(x => x.GetString() ?? "").Where(s => s.Length > 0).ToList() : [];

    private async Task Load()
    {
        var qs = $"api/usage/call-logs?limit={_limit}";
        foreach (var p in _providers) qs += $"&providers[]={Uri.EscapeDataString(p)}";
        if (!string.IsNullOrEmpty(_q)) qs += $"&q={Uri.EscapeDataString(_q)}";
        if (!string.IsNullOrEmpty(_rid)) qs += $"&correlationId={Uri.EscapeDataString(_rid)}";
        if (!string.IsNullOrEmpty(_model)) qs += $"&model={Uri.EscapeDataString(_model)}";
        if (!string.IsNullOrEmpty(_conn)) qs += $"&conn={Uri.EscapeDataString(_conn)}";
        if (!string.IsNullOrEmpty(_key)) qs += $"&key={Uri.EscapeDataString(_key)}";
        if (_status == "4xx") qs += "&status=4xx";
        else if (_status == "5xx") qs += "&status=5xx";
        else if (_status == "err") qs += "&status=err";
        else if (!string.IsNullOrEmpty(_status)) qs += $"&status={Uri.EscapeDataString(_status)}";
        if (!string.IsNullOrEmpty(_preset)) qs += $"&from={Uri.EscapeDataString(FromPreset(_preset))}";
        var r = await Api.GetAsync(qs);
        _total = r.TryGetProperty("total", out var t) ? t.GetInt32() : 0;
        _logs = r.GetProperty("items").EnumerateArray().Select(l => new L(
            l.GetProperty("id").GetInt64(),
            l.TryGetProperty("at", out var at) ? at.GetString() ?? "" : "",
            l.TryGetProperty("provider", out var p) ? p.GetString() : null,
            l.TryGetProperty("model", out var mo) ? mo.GetString() : null,
            l.TryGetProperty("status", out var st) ? st.GetString() : null,
            l.TryGetProperty("type", out var ty) ? ty.GetString() : null,
            l.TryGetProperty("key", out var k) ? k.GetString() : null,
            l.TryGetProperty("connectionId", out var c) ? c.GetString() : null,
            l.TryGetProperty("latencyMs", out var lm) ? lm.GetInt64() : 0)).ToList();
    }

    private static string FromPreset(string p) => (p switch
    {
        "1h" => DateTime.UtcNow.AddHours(-1),
        "1d" => DateTime.UtcNow.AddDays(-1),
        "7d" => DateTime.UtcNow.AddDays(-7),
        "30d" => DateTime.UtcNow.AddDays(-30),
        _ => DateTime.MinValue,
    }).ToString("yyyy-MM-dd HH:mm:ss");

    private static string StatusClass(string? s) =>
        s is not null && s.StartsWith('2') ? "ok"
        : s is not null && s.StartsWith('4') ? "warn"
        : s is not null && s.StartsWith('5') ? "err"
        : s == "err" || s == "error" ? "err" : "";

    private static string Mask(string? k) =>
        string.IsNullOrEmpty(k) ? "—" : k.Length <= 10 ? k : k[..8] + "…";

    private async Task Toggle(L l)
    {
        if (_detail?.Id == l.Id) { _detail = null; _gen = null; return; }
        _detail = l;
        _detailJson = "…";
        _gen = null;
        try
        {
            var r = await Api.GetAsync($"api/usage/call-logs/{l.Id}");
            _detailJson = r.TryGetProperty("detail", out var d) ? Pretty(d.ToString()) : Pretty(r.GetProperty("call").ToString());
        }
        catch { _detailJson = "(unavailable)"; }
        // SPEC-143: generation detail — meta + provider-attempts waterfall.
        try
        {
            var g = await Api.GetAsync($"api/v1/generation?id={l.Id}");
            var att = g.TryGetProperty("waterfall", out var w) && w.ValueKind == JsonValueKind.Array
                ? w.EnumerateArray().Select(a => (
                    a.TryGetProperty("attemptNumber", out var an) ? an.GetInt32() : 0,
                    a.TryGetProperty("provider", out var ap) ? ap.GetString() : null,
                    a.TryGetProperty("upstreamStatus", out var us) ? us.ToString() : null,
                    a.TryGetProperty("level", out var lv) ? lv.GetString() : null,
                    a.TryGetProperty("latencyMs", out var lm) ? lm.GetInt64() : 0,
                    a.TryGetProperty("firstChunkMs", out var fc) && fc.ValueKind == JsonValueKind.Number ? fc.GetInt64() : (long?)null,
                    a.TryGetProperty("error", out var er) ? er.GetString() : null)).ToArray()
                : [];
            _gen = (
                g.TryGetProperty("cost", out var c) ? (decimal)c.GetDouble() : 0,
                g.TryGetProperty("promptTokens", out var p) ? p.GetInt32() : 0,
                g.TryGetProperty("completionTokens", out var ct) ? ct.GetInt32() : 0,
                g.TryGetProperty("endpoint", out var ep) ? ep.GetString() : null,
                g.TryGetProperty("correlationId", out var ci) ? ci.GetString() : null,
                att);
        }
        catch { }
    }

    private void ToggleProvider(string p)
    {
        if (!_providers.Remove(p)) _providers.Add(p);
        _ = Load();
    }

    private async Task ToggleRecording(ChangeEventArgs e)
    {
        _recording = e.Value is bool b && b;
        try { await Api.PutAsync("api/settings", new { requestLogging = _recording }); } catch { }
    }

    private async Task ToggleIoLogging(ChangeEventArgs e)
    {
        _ioLogging = e.Value is bool b && b;
        try
        {
            // PUT /api/settings replaces top-level keys — merge observability first.
            var s = await Api.GetAsync("api/settings");
            var dict = s.TryGetProperty("observability", out var obs) && obs.ValueKind == JsonValueKind.Object
                ? obs.EnumerateObject().ToDictionary(p => p.Name, p => p.Value.Clone())
                : new Dictionary<string, JsonElement>();
            dict["ioLogging"] = JsonSerializer.SerializeToElement(_ioLogging);
            await Api.PutAsync("api/settings", new { observability = dict });
        }
        catch { }
    }

    private async Task Clean()
    {
        await Api.PostAsync("api/logs/prune?keep=0", new { });
        _detail = null;
        await Load();
    }

    private async Task More() { _limit += 200; await Load(); }

    private static string Pretty(string s)
    {
        try { return JsonSerializer.Serialize(JsonDocument.Parse(s).RootElement, new JsonSerializerOptions { WriteIndented = true }); }
        catch { return s; }
    }
}
