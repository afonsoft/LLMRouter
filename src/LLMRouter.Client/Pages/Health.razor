@page "/dashboard/health"
@page "/dashboard/resilience/connections"
@page "/dashboard/resilience/cooldowns"
@inject Api Api
@inject Loc Loc
@inject NavigationManager Nav

<div>
    <h1 class="page-title">@(IsCooldowns ? "Cooldowns" : "Connection health")</h1>
    <p class="page-desc">@(IsCooldowns ? "Connections skipped by the circuit breaker" : "Last test result and cooldown state per connection")</p>
</div>

@if (IsCooldowns)
{
    <div class="card card-p mt-6">
        <table class="tbl">
            <thead><tr><th>Connection</th><th>Failures</th><th>Cooling</th><th>Until</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in _cooldowns)
                {
                    <tr>
                        <td class="mono sm">@c.GetProperty("connectionId").GetString()</td>
                        <td>@c.GetProperty("failures").GetInt32()</td>
                        <td><span class="badge @(c.GetProperty("cooling").GetBoolean() ? "err" : "ok")">@(c.GetProperty("cooling").GetBoolean() ? "cooling" : "ok")</span></td>
                        <td class="mono sm">@(c.GetProperty("cooldownUntil").ValueKind == JsonValueKind.String ? c.GetProperty("cooldownUntil").GetString() : "—")</td>
                        <td><button class="btn btn-sm" @onclick='() => Clear(c.GetProperty("connectionId").GetString()!)'>Clear</button></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_cooldowns.Count == 0) { <div class="empty"><span class="material-symbols-outlined">timer_off</span>No cooldowns</div> }
    </div>

    <div class="card card-p mt-4">
        <div class="flex between"><div class="bold">@Loc.T("health.modelCooldowns", "Model cooldowns")</div></div>
        <div class="flex gap-2 mt-2 items-end">
            <input @bind="_mcProvider" placeholder="provider" />
            <input @bind="_mcModel" placeholder="model (or *)" />
            <input @bind="_mcMinutes" placeholder="minutes" style="width:90px" />
            <button class="btn btn-sm" @onclick="AddModelCooldown">@Loc.T("common.add", "Add")</button>
        </div>
        <table class="tbl mt-2">
            <thead><tr><th>Provider</th><th>Model</th><th>Until</th><th>Reason</th><th></th></tr></thead>
            <tbody>
                @foreach (var m in _modelCooldowns)
                {
                    <tr>
                        <td class="mono sm">@m.GetProperty("provider").GetString()</td>
                        <td class="mono sm">@m.GetProperty("model").GetString()</td>
                        <td class="mono sm">@m.GetProperty("until").GetString()</td>
                        <td class="dim sm">@(m.TryGetProperty("reason", out var rr) && rr.ValueKind == JsonValueKind.String ? rr.GetString() : "")</td>
                        <td><button class="btn btn-sm" @onclick='() => DelModelCooldown(m.GetProperty("id").GetString()!)'>Clear</button></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_modelCooldowns.Count == 0) { <div class="empty sm"><span class="material-symbols-outlined">timer_off</span>No model cooldowns</div> }
    </div>

    <div class="card card-p mt-4">
        <div class="flex between"><div class="bold">@Loc.T("health.fallbackChains", "Fallback chains")</div></div>
        <div class="flex gap-2 mt-2 items-end">
            <input @bind="_chainName" placeholder="chain name" />
            <input @bind="_chainSteps" placeholder="models, comma separated" style="min-width:260px" />
            <button class="btn btn-sm" @onclick="AddChain">@Loc.T("common.add", "Add")</button>
        </div>
        <table class="tbl mt-2">
            <thead><tr><th>Name</th><th>Steps</th><th>Active</th><th></th></tr></thead>
            <tbody>
                @foreach (var ch in _chains)
                {
                    <tr>
                        <td class="mono sm">@ch.GetProperty("name").GetString()</td>
                        <td class="mono sm">@string.Join(" → ", ch.GetProperty("steps").EnumerateArray().Select(x => x.ValueKind == JsonValueKind.Object && x.TryGetProperty("model", out var mm) ? mm.GetString() : x.GetString()))</td>
                        <td><span class="badge @(ch.GetProperty("active").GetBoolean() ? "ok" : "")">@(ch.GetProperty("active").GetBoolean() ? "on" : "off")</span></td>
                        <td><button class="btn btn-sm btn-danger" @onclick='() => DelChain(ch.GetProperty("id").GetString()!)'>Delete</button></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_chains.Count == 0) { <div class="empty sm"><span class="material-symbols-outlined">link</span>No fallback chains</div> }
    </div>
}
else
{
    <div class="card card-p mt-6">
        <table class="tbl">
            <thead><tr><th>Provider</th><th>Connection</th><th>Active</th><th>Last test</th><th>Cooldown</th><th>Error</th></tr></thead>
            <tbody>
                @foreach (var c in _conns)
                {
                    var ts = c.TryGetProperty("testStatus", out var t) && t.ValueKind == JsonValueKind.String ? t.GetString() : "never";
                    var cooling = c.TryGetProperty("cooldown", out var cd) && cd.ValueKind == JsonValueKind.Object;
                    <tr>
                        <td class="mono sm">@c.GetProperty("provider").GetString()</td>
                        <td class="mono sm">@c.GetProperty("name").GetString()</td>
                        <td><span class="badge @(c.GetProperty("isActive").GetBoolean() ? "ok" : "")">@(c.GetProperty("isActive").GetBoolean() ? "on" : "off")</span></td>
                        <td><span class="badge @(ts == "ok" ? "ok" : ts == "never" ? "" : "err")">@ts</span></td>
                        <td>@(cooling ? "🧊" : "—")</td>
                        <td class="dim sm" style="max-width:280px;overflow:hidden;text-overflow:ellipsis">@(c.TryGetProperty("lastError", out var le) && le.ValueKind == JsonValueKind.String ? le.GetString() : "")</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_conns.Count == 0) { <div class="empty"><span class="material-symbols-outlined">health_and_safety</span>No connections</div> }
    </div>
}

@code {
    private bool IsCooldowns => Nav.Uri.Contains("/cooldowns");
    private List<JsonElement> _conns = [];
    private List<JsonElement> _cooldowns = [];
    private List<JsonElement> _modelCooldowns = [];
    private List<JsonElement> _chains = [];
    private string _mcProvider = "", _mcModel = "", _mcMinutes = "30", _chainName = "", _chainSteps = "";

    protected override async Task OnInitializedAsync()
    {
        var r = await Api.GetAsync("api/health/connections");
        _conns = r.GetProperty("connections").EnumerateArray().ToList();
        var cd = await Api.GetAsync("api/resilience/cooldowns");
        _cooldowns = cd.GetProperty("cooldowns").EnumerateArray().ToList();
        await LoadExtras();
    }

    private async Task LoadExtras()
    {
        var mc = await Api.GetAsync("api/resilience/model-cooldowns");
        _modelCooldowns = mc.GetProperty("cooldowns").EnumerateArray().ToList();
        var ch = await Api.GetAsync("api/fallback/chains");
        _chains = ch.GetProperty("chains").EnumerateArray().ToList();
    }

    private async Task AddModelCooldown()
    {
        if (string.IsNullOrWhiteSpace(_mcModel)) return;
        var minutes = double.TryParse(_mcMinutes, out var mm) ? mm : 30;
        await Api.PostAsync("api/resilience/model-cooldowns",
            new { provider = _mcProvider, model = _mcModel, minutes });
        _mcModel = "";
        await LoadExtras();
    }

    private async Task DelModelCooldown(string id)
    {
        await Api.DeleteAsync($"api/resilience/model-cooldowns/{id}");
        await LoadExtras();
    }

    private async Task AddChain()
    {
        if (string.IsNullOrWhiteSpace(_chainName)) return;
        var steps = _chainSteps.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(m => new { model = m }).ToList();
        await Api.PostAsync("api/fallback/chains", new { name = _chainName, steps, active = true });
        _chainName = ""; _chainSteps = "";
        await LoadExtras();
    }

    private async Task DelChain(string id)
    {
        await Api.DeleteAsync($"api/fallback/chains/{id}");
        await LoadExtras();
    }

    private async Task Clear(string id)
    {
        await Api.DeleteAsync($"api/resilience/cooldowns/{id}");
        var cd = await Api.GetAsync("api/resilience/cooldowns");
        _cooldowns = cd.GetProperty("cooldowns").EnumerateArray().ToList();
    }
}
