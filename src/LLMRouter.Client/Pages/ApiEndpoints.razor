@page "/dashboard/api-endpoints"
@inject Api Api
@inject Loc Loc

<h1 class="page-title">@Loc.T("apiEndpoints.title", "API explorer")</h1>
<p class="page-desc">@Loc.T("apiEndpoints.subtitle", "Every route this router exposes — from the live OpenAPI spec")</p>

@if (_groups.Count == 0) { <p class="muted">…</p> }
else
{
    <div class="col gap-4" style="max-width:960px">
        @foreach (var grp in _groups)
        {
            <div class="card card-p">
                <div class="bold mb-2">@grp.Name <span class="muted xs">(@grp.Endpoints.Count)</span></div>
                @foreach (var e in grp.Endpoints)
                {
                    <div class="flex" style="align-items:flex-start;gap:8px;padding:5px 0;border-top:1px solid var(--border,#333)">
                        <button class="badge ghost sm mono" style="min-width:56px" @onclick="() => Toggle(e)">@e.Method</button>
                        <div style="flex:1">
                            <code class="sm">@e.Path</code>
                            @if (e.Summary.Length > 0) { <span class="muted xs" style="margin-left:6px">@e.Summary</span> }
                            @if (e.Open)
                            {
                                <div class="mt-2" style="background:var(--surface2,#1a1a1a);border-radius:6px;padding:8px">
                                    @if (e.AcceptsBody)
                                    {
                                        <textarea class="input mono" rows="4" @bind="e.Body" placeholder="{ … }" style="width:100%"></textarea>
                                    }
                                    <div class="flex gap-2 mt-2" style="align-items:center">
                                        <button class="btn btn-sm" @onclick="() => Try(e)" disabled="@e.Busy">@Loc.T("apiEndpoints.try", "Try it")</button>
                                        @if (e.Result is not null)
                                        {
                                            <span class="badge @(e.Status < 400 ? "ok" : "err")">@e.Status</span>
                                            <span class="muted xs">@e.Ms ms</span>
                                        }
                                    </div>
                                    @if (e.Result is not null)
                                    {
                                        <pre class="mono xs" style="margin-top:6px;max-height:220px;overflow:auto;white-space:pre-wrap">@e.Result</pre>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private sealed class Ep
    {
        public string Path = "", Method = "", Summary = "", Body = "";
        public bool AcceptsBody, Open, Busy;
        public int Status; public long Ms; public string? Result;
    }
    private sealed class Grp { public string Name = ""; public List<Ep> Endpoints = []; }
    private readonly List<Grp> _groups = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var spec = await Api.GetAsync("api/openapi/spec");
            var paths = spec.GetProperty("paths");
            var byTag = new SortedDictionary<string, List<Ep>>();
            foreach (var p in paths.EnumerateObject())
            {
                foreach (var op in p.Value.EnumerateObject())
                {
                    var tag = op.Value.TryGetProperty("tags", out var ts) && ts.GetArrayLength() > 0
                        ? ts[0].GetString() ?? "api" : "api";
                    var ep = new Ep
                    {
                        Path = p.Name, Method = op.Name.ToUpperInvariant(),
                        Summary = op.Value.TryGetProperty("summary", out var s) ? s.GetString() ?? "" : "",
                        AcceptsBody = op.Value.TryGetProperty("requestBody", out _),
                    };
                    if (!byTag.TryGetValue(tag, out var l)) byTag[tag] = l = [];
                    l.Add(ep);
                }
            }
            foreach (var (k, v) in byTag) _groups.Add(new Grp { Name = k, Endpoints = v });
        }
        catch { /* best-effort: failure is non-fatal */ }
    }

    private void Toggle(Ep e) => e.Open = !e.Open;

    private async Task Try(Ep e)
    {
        e.Busy = true; e.Result = null;
        try
        {
            object body = e.AcceptsBody && e.Body.Length > 0
                ? JsonDocument.Parse(e.Body).RootElement : new { };
            var r = await Api.PostAsync("api/openapi/try", new { path = e.Path, method = e.Method, body });
            e.Status = r.GetProperty("status").GetInt32();
            e.Ms = r.GetProperty("ms").GetInt64();
            var raw = r.GetProperty("body").GetString() ?? "";
            try { e.Result = JsonDocument.Parse(raw).RootElement.GetRawText(); }
            catch { e.Result = raw.Length > 2000 ? raw[..2000] + "…" : raw; }
        }
        catch (Exception ex) { e.Status = 0; e.Result = ex.Message; }
        e.Busy = false;
    }
}
