@page "/dashboard/providers/{Id}"
@inject Api Api
@inject Loc Loc
@inject NavigationManager Nav

@if (_provider is null)
{
    <div class="empty"><span class="material-symbols-outlined">cloud_off</span>@Loc.T("providers.notFound", "Provider not found")</div>
    return;
}

<button class="btn btn-sm" @onclick='() => Nav.NavigateTo("/dashboard/providers")'>
    <span class="material-symbols-outlined" style="font-size:15px">arrow_back</span> @Loc.T("providers.back", "Providers")
</button>

<div class="flex between mt-4">
    <div class="flex gap-3" style="align-items:center">
        <span class="pcard-icon" style="@(_color is not null ? $"color:{_color}" : "")">
            <span class="material-symbols-outlined" style="font-size:26px">@(_icon ?? "cloud")</span>
        </span>
        <div>
            <h1 class="page-title" style="margin:0">@(_uiName ?? Id)</h1>
            <p class="page-desc" style="margin:0">
                <span class="mono sm">@Id</span>
                @if (_website is not null) { <span> · <a href="@_website" target="_blank" class="link">@_website</a></span> }
                <span> · <span class="badge info">@_authType</span></span>
            </p>
        </div>
    </div>
    <div class="flex gap-2">
        <button class="btn" @onclick="TestSelected" disabled="@(_selected.Count == 0 || _batchBusy)">
            <span class="material-symbols-outlined" style="font-size:17px">bolt</span>
            @(_batchBusy ? Loc.T("providers.testing", "Testing…") : $"{Loc.T("providers.testSelected", "Test selected")} ({_selected.Count})")
        </button>
        <button class="btn btn-primary" @onclick="() => _adding = true">
            <span class="material-symbols-outlined" style="font-size:17px">add</span>
            @Loc.T("providers.add", "Add connection")
        </button>
    </div>
</div>

<div class="card mt-6 scroll-x">
    <table class="table">
        <thead><tr>
            <th style="width:32px"><input type="checkbox" checked="@(_conns.Count > 0 && _selected.Count == _conns.Count)" @onchange="ToggleAll" /></th>
            <th>@Loc.T("providers.name", "Name")</th><th>@Loc.T("providers.email", "Email")</th><th>@Loc.T("providers.priority", "Priority")</th><th>@Loc.T("providers.status", "Status")</th><th>@Loc.T("providers.lastTest", "Last test")</th><th></th>
        </tr></thead>
        <tbody>
            @foreach (var c in _conns)
            {
                <tr>
                    <td><input type="checkbox" checked="@_selected.Contains(c.Id)" @onchange="e => Toggle(c.Id, e)" /></td>
                    <td>@c.Name</td>
                    <td class="muted sm">@(c.Email ?? "—")</td>
                    <td>
                        <div class="flex gap-1" style="align-items:center">
                            <button class="btn btn-sm" title="priority-" disabled="@(c.Priority <= 0)" @onclick="() => SetPriority(c, c.Priority - 1)">−</button>
                            <span class="mono sm">@c.Priority</span>
                            <button class="btn btn-sm" title="priority+" @onclick="() => SetPriority(c, c.Priority + 1)">+</button>
                        </div>
                    </td>
                    <td><span class="badge @(c.IsActive ? "ok" : "err")">@(c.IsActive ? "active" : "off")</span></td>
                    <td class="sm muted">@c.TestLabel</td>
                    <td class="flex gap-2">
                        <button class="btn btn-sm" @onclick="() => Edit(c)">@Loc.T("common.edit", "Edit")</button>
                        <button class="btn btn-sm" @onclick="() => Test(c)">@Loc.T("providers.test", "Test")</button>
                        <button class="btn btn-sm" @onclick="() => ToggleActive(c)">@(c.IsActive ? Loc.T("common.disable", "Disable") : Loc.T("common.enable", "Enable"))</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => Delete(c.Id)">@Loc.T("common.delete", "Delete")</button>
                    </td>
                </tr>
            }
            @if (_conns.Count == 0)
            {
                <tr><td colspan="7"><div class="empty"><span class="material-symbols-outlined">dns</span>@Loc.T("providers.empty", "No connections yet")</div></td></tr>
            }
        </tbody>
    </table>
</div>

@if (_batchResults is not null)
{
    <div class="card card-p mt-4">
        <h3 class="bold">@Loc.T("providers.batchResults", "Batch test results")</h3>
        @foreach (var r in _batchResults)
        {
            var name = _conns.FirstOrDefault(c => c.Id == r.Id)?.Name ?? r.Id;
            <div class="flex gap-2 sm" style="align-items:center">
                <span class="badge @(r.Ok ? "ok" : "err")">@(r.Ok ? "ok" : (r.Error == "not found" ? "missing" : "fail"))</span>
                <span>@name</span>
                <span class="muted mono">@r.LatencyMs ms</span>
                @if (r.Error is not null && !r.Ok)
                {
                    <span class="muted sm" style="max-width:420px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@r.Error">@r.Error</span>
                }
            </div>
        }
    </div>
}

@if (_test is not null)
{
    <div class="card card-p mt-4">
        <h3 class="bold">
            @Loc.T("providers.testResult", "Connection test")
            <span class="badge @(_testOk ? "ok" : "err")" style="margin-left:8px">@_testStatus</span>
            <span class="muted sm" style="margin-left:8px">@_testLatency ms</span>
        </h3>
        <pre class="code">@_test</pre>
    </div>
}

@if (_adding || _editing is not null)
{
    <div class="modal-back" @onclick="CloseModal">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-head"><span class="modal-title">@(_editing is null ? Loc.T("providers.add", "Add connection") : Loc.T("providers.edit", "Edit connection"))</span>
                <button class="icon-btn" @onclick="CloseModal"><span class="material-symbols-outlined" style="font-size:17px">close</span></button>
            </div>
            <div class="modal-body">
                <label class="lbl">@Loc.T("providers.name", "Name")</label>
                <input class="input" @bind="_name" />
                @if (_authType is "apikey" or "optional")
                {
                    <div class="mt-4">
                        <label class="lbl">API key @(_editing is not null ? "(leave blank to keep)" : "")</label>
                        <input class="input mono" type="password" @bind="_key" />
                    </div>
                }
                <div class="mt-4">
                    <label class="lbl">@Loc.T("providers.baseUrl", "Base URL (optional override)")</label>
                    <input class="input mono" @bind="_baseUrl" placeholder="@(_providerBaseUrl ?? "https://api.openai.com")" />
                </div>
                <div class="mt-4">
                    <label class="lbl">@Loc.T("providers.email", "Email (optional)")</label>
                    <input class="input" @bind="_email" />
                </div>
                @if (_authType == "oauth")
                {
                    <p class="muted sm mt-4">@Loc.T("providers.oauthHint", "OAuth sign-in flow arrives in SPEC-011 — save with an access token in the API key field for now.")</p>
                }
            </div>
            <div class="modal-foot">
                <button class="btn" @onclick="CloseModal">@Loc.T("common.cancel", "Cancel")</button>
                <button class="btn btn-primary" @onclick="Save" disabled="@string.IsNullOrEmpty(_name)">@Loc.T("common.save", "Save")</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private record Conn(string Id, string? Name, string? Email, int Priority, bool IsActive, string Data,
        string? TestStatus, long? LatencyMs, string? LastTestAt)
    {
        public string TestLabel => TestStatus is null ? "—" : $"{TestStatus}{(LatencyMs is not null ? $" · {LatencyMs}ms" : "")}";
    }

    private JsonElement? _provider;
    private string? _uiName, _icon, _color, _website, _providerBaseUrl;
    private string _authType = "apikey";
    private List<Conn> _conns = [];
    private bool _adding;
    private Conn? _editing;
    private string _name = "", _key = "", _baseUrl = "", _email = "";
    private string? _test, _testStatus;
    private bool _testOk;
    private long _testLatency;
    private readonly HashSet<string> _selected = [];
    private bool _batchBusy;
    private List<BatchResult>? _batchResults;

    private record BatchResult(string Id, bool Ok, long LatencyMs, string? Error);

    protected override async Task OnInitializedAsync()
    {
        var r = await Api.GetAsync($"api/providers/{Id}");
        _provider = r.GetProperty("provider");
        _authType = _provider.Value.TryGetProperty("authType", out var at) ? at.GetString() ?? "apikey" : "apikey";
        _providerBaseUrl = _provider.Value.TryGetProperty("baseUrl", out var bu) ? bu.GetString() : null;
        if (r.TryGetProperty("ui", out var ui) && ui.ValueKind == JsonValueKind.Object)
        {
            _uiName = ui.TryGetProperty("name", out var n) ? n.GetString() : null;
            _icon = ui.TryGetProperty("icon", out var i) ? i.GetString() : null;
            _color = ui.TryGetProperty("color", out var c) && c.ValueKind == JsonValueKind.String ? c.GetString() : null;
            _website = ui.TryGetProperty("website", out var w) ? w.GetString() : null;
        }
        Load(r);
    }

    private void Load(JsonElement r)
    {
        _conns = r.GetProperty("connections").EnumerateArray().Select(c =>
        {
            var data = c.TryGetProperty("data", out var d) ? d.GetString() ?? "{}" : "{}";
            string? ts = null, lt = null; long? lat = null;
            try
            {
                var de = JsonDocument.Parse(data).RootElement;
                ts = de.TryGetProperty("testStatus", out var t) ? t.GetString() : null;
                lt = de.TryGetProperty("lastTestAt", out var l) ? l.GetString() : null;
                lat = de.TryGetProperty("latencyMs", out var lm) && lm.ValueKind == JsonValueKind.Number ? lm.GetInt64() : null;
            }
            catch { /* best-effort: failure is non-fatal */ }
            return new Conn(c.GetProperty("id").GetString()!,
                c.TryGetProperty("name", out var n) ? n.GetString() : null,
                c.TryGetProperty("email", out var e) ? e.GetString() : null,
                c.TryGetProperty("priority", out var pr) ? pr.GetInt32() : 0,
                c.GetProperty("isActive").GetBoolean(), data, ts, lat, lt);
        }).ToList();
    }

    private async Task Reload()
    {
        var r = await Api.GetAsync($"api/providers/{Id}");
        Load(r);
    }

    private void CloseModal() { _adding = false; _editing = null; _name = _key = _baseUrl = _email = ""; }

    private void Edit(Conn c)
    {
        _editing = c;
        _name = c.Name ?? "";
        _email = c.Email ?? "";
        try { _baseUrl = JsonDocument.Parse(c.Data).RootElement.TryGetProperty("baseUrl", out var b) ? b.GetString() ?? "" : ""; }
        catch { _baseUrl = ""; }
    }

    private async Task Save()
    {
        var data = new Dictionary<string, string>();
        if (!string.IsNullOrEmpty(_key)) data["apiKey"] = _key;
        if (!string.IsNullOrEmpty(_baseUrl)) data["baseUrl"] = _baseUrl;
        if (_editing is not null)
        {
            var merged = JsonDocument.Parse(_editing.Data).RootElement.EnumerateObject()
                .ToDictionary(p => p.Name, p => p.Value.Clone());
            foreach (var kv in data) merged[kv.Key] = JsonSerializer.SerializeToElement(kv.Value);
            await Api.PutAsync($"api/provider-connections/{_editing.Id}",
                new { name = _name, email = _email, data = merged });
        }
        else
        {
            await Api.PostAsync("api/provider-connections",
                new { provider = Id, name = _name, email = _email, authType = _authType, data });
        }
        CloseModal();
        await Reload();
    }

    private async Task SetPriority(Conn c, int p)
    {
        await Api.PutAsync($"api/provider-connections/{c.Id}", new { priority = p });
        await Reload();
    }

    private async Task ToggleActive(Conn c)
    {
        await Api.PutAsync($"api/provider-connections/{c.Id}", new { isActive = !c.IsActive });
        await Reload();
    }

    private async Task Delete(string id) { await Api.DeleteAsync($"api/provider-connections/{id}"); await Reload(); }

    private void Toggle(string id, ChangeEventArgs e)
    {
        if (e.Value is true) _selected.Add(id); else _selected.Remove(id);
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        _selected.Clear();
        if (e.Value is true) foreach (var c in _conns) _selected.Add(c.Id);
    }

    private async Task TestSelected()
    {
        _batchBusy = true; _batchResults = null; _test = null;
        try
        {
            var r = await Api.PostAsync("api/providers/test-batch", new { ids = _selected.ToArray() });
            _batchResults = r.TryGetProperty("results", out var rs)
                ? rs.EnumerateArray().Select(x => new BatchResult(
                    x.GetProperty("id").GetString() ?? "",
                    x.GetProperty("ok").GetBoolean(),
                    x.TryGetProperty("latencyMs", out var l) ? l.GetInt64() : 0,
                    x.TryGetProperty("error", out var e) && e.ValueKind == JsonValueKind.String ? e.GetString() : null)).ToList()
                : [];
        }
        finally { _batchBusy = false; }
        await Reload();
    }

    private async Task Test(Conn c)
    {
        _test = "Testing…"; _testStatus = null; _testLatency = 0;
        var r = await Api.PostAsync($"api/provider-connections/{c.Id}/test", new { });
        _testOk = r.TryGetProperty("ok", out var ok) && ok.GetBoolean();
        _testStatus = r.TryGetProperty("status", out var s) ? s.GetString() : null;
        _testLatency = r.TryGetProperty("latencyMs", out var l) ? l.GetInt64() : 0;
        var err = r.TryGetProperty("error", out var e) && e.ValueKind == JsonValueKind.String ? e.GetString() : null;
        _test = err ?? JsonSerializer.Serialize(r, new JsonSerializerOptions { WriteIndented = true });
        await Reload();
    }
}
