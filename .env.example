# LLMRouter — variáveis de ambiente (copie para .env)
# docker-compose lê este arquivo automaticamente via env_file.

# ---- servidor ----
# Porta HTTP do gateway + dashboard
LLMROUTER_PORT=20128
ASPNETCORE_URLS=http://+:20128
ASPNETCORE_ENVIRONMENT=Production

# Caminho do SQLite (dentro do container use /data)
LLMROUTER_DB_PATH=/data/llmrouter.db

# Senha inicial do admin no primeiro boot (opcional — senão definida no setup web)
# LLMROUTER_ADMIN_PASSWORD=

# ---- gateway / LLM de teste (opcional) ----
# Gateway LLM externo usado pelos testes E2E/agentes (OmniRoute)
# LLM_PROVIDER=
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# ---- OAuth client credentials (por provider) ----
# Só configure os providers que você for usar — a página Tokens mostra o status.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# CLAUDE_OAUTH_CLIENT_ID=
# CLAUDE_OAUTH_CLIENT_SECRET=
# GEMINI_OAUTH_CLIENT_ID=
# GEMINI_OAUTH_CLIENT_SECRET=
# KIMI_CODING_OAUTH_CLIENT_ID=
# KIMI_CODING_OAUTH_CLIENT_SECRET=
# QODER_OAUTH_CLIENT_SECRET=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=
# GITLAB_DUO_OAUTH_CLIENT_SECRET=
