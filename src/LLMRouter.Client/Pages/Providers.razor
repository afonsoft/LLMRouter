@page "/dashboard/providers"
@inject Api Api
@inject Loc Loc
@inject IJSRuntime JS

<div class="flex between">
    <div>
        <h1 class="page-title">@Loc.T("providers.title", "Providers")</h1>
        <p class="page-desc">@Loc.T("providers.subtitle", "Provider catalog and your connections")</p>
    </div>
    <button class="btn btn-primary" @onclick="() => _adding = true">
        <span class="material-symbols-outlined" style="font-size:17px">add</span>
        @Loc.T("providers.add", "Add connection")
    </button>
</div>

<div class="card mt-6 scroll-x">
    <table class="table">
        <thead><tr><th>@Loc.T("providers.provider", "Provider")</th><th>@Loc.T("providers.name", "Name")</th><th>@Loc.T("providers.auth", "Auth")</th><th>@Loc.T("providers.priority", "Priority")</th><th>@Loc.T("providers.status", "Status")</th><th></th></tr></thead>
        <tbody>
            @foreach (var c in _conns)
            {
                <tr>
                    <td class="mono sm">@c.Provider</td>
                    <td>@c.Name</td>
                    <td class="muted sm">@c.AuthType</td>
                    <td>@c.Priority</td>
                    <td><span class="badge @(c.IsActive ? "ok" : "err")">@(c.IsActive ? "active" : "off")</span></td>
                    <td class="flex gap-2">
                        <button class="btn btn-sm" @onclick="() => Test(c)">Test</button>
                        <button class="btn btn-sm" @onclick="() => ToggleActive(c)">@(c.IsActive ? "Disable" : "Enable")</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => Delete(c.Id)">Delete</button>
                    </td>
                </tr>
            }
            @if (_conns.Count == 0)
            {
                <tr><td colspan="6"><div class="empty"><span class="material-symbols-outlined">dns</span>@Loc.T("providers.empty", "No connections yet")</div></td></tr>
            }
        </tbody>
    </table>
</div>

@if (_testResult is not null)
{
    <div class="card card-p mt-4">
        <h3 class="bold">@Loc.T("providers.testResult", "Connection test")</h3>
        <pre class="code">@_testResult</pre>
    </div>
}

@if (_adding)
{
    <div class="modal-back" @onclick="() => _adding = false">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-head"><span class="modal-title">@Loc.T("providers.add", "Add connection")</span>
                <button class="icon-btn" @onclick="() => _adding = false"><span class="material-symbols-outlined" style="font-size:17px">close</span></button>
            </div>
            <div class="modal-body">
                <label class="lbl">@Loc.T("providers.provider", "Provider")</label>
                <select class="input" @bind="_newProvider" @bind:after="OnProviderChanged">
                    <option value="">—</option>
                    @foreach (var p in _catalog)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
                <div class="mt-4">
                    <label class="lbl">@Loc.T("providers.name", "Name")</label>
                    <input class="input" @bind="_newName" />
                </div>
                <div class="mt-4">
                    <label class="lbl">API key</label>
                    <input class="input mono" type="password" @bind="_newKey" />
                </div>
                <div class="mt-4">
                    <label class="lbl">@Loc.T("providers.baseUrl", "Base URL (optional override)")</label>
                    <input class="input mono" @bind="_newBaseUrl" placeholder="https://api.openai.com" />
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn" @onclick="() => _adding = false">@Loc.T("common.cancel", "Cancel")</button>
                <button class="btn btn-primary" @onclick="Create" disabled="@(string.IsNullOrEmpty(_newProvider))">@Loc.T("common.create", "Create")</button>
            </div>
        </div>
    </div>
}

@code {
    private record Conn(string Id, string Provider, string? AuthType, string Name, int Priority, bool IsActive, string? Data);
    private List<Conn> _conns = [];
    private List<string> _catalog = [];
    private bool _adding;
    private string _newProvider = "", _newName = "", _newKey = "", _newBaseUrl = "";
    private string? _testResult;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        var cat = await Api.GetAsync("api/providers");
        foreach (var grp in cat.GetProperty("categories").EnumerateArray())
            foreach (var p in grp.GetProperty("providers").EnumerateArray())
                _catalog.Add(p.GetProperty("id").GetString()!);
        _catalog.Sort();
    }

    private async Task Load()
    {
        var r = await Api.GetAsync("api/provider-connections");
        _conns = r.GetProperty("connections").EnumerateArray().Select(c => new Conn(
            c.GetProperty("id").GetString()!, c.GetProperty("provider").GetString()!,
            c.TryGetProperty("authType", out var at) ? at.GetString() : null,
            c.GetProperty("name").GetString() ?? "",
            c.TryGetProperty("priority", out var pr) ? pr.GetInt32() : 0,
            c.GetProperty("isActive").GetBoolean(),
            c.TryGetProperty("data", out var d) ? d.GetString() : null)).ToList();
    }

    private void OnProviderChanged() { if (string.IsNullOrEmpty(_newName)) _newName = _newProvider; }

    private async Task Create()
    {
        var data = new Dictionary<string, string>();
        if (!string.IsNullOrEmpty(_newKey)) data["apiKey"] = _newKey;
        if (!string.IsNullOrEmpty(_newBaseUrl)) data["baseUrl"] = _newBaseUrl;
        await Api.PostAsync("api/provider-connections", new
        {
            provider = _newProvider,
            name = _newName,
            authType = "apikey",
            data,
        });
        _adding = false;
        _newProvider = _newName = _newKey = _newBaseUrl = "";
        await Load();
    }

    private async Task ToggleActive(Conn c)
    {
        await Api.PutAsync($"api/provider-connections/{c.Id}", new { isActive = !c.IsActive });
        await Load();
    }

    private async Task Delete(string id) { await Api.DeleteAsync($"api/provider-connections/{id}"); await Load(); }

    private async Task Test(Conn c)
    {
        _testResult = "Testing…";
        var r = await Api.PostAsync($"api/provider-connections/{c.Id}/test", new { });
        var s = JsonSerializer.Serialize(r, new JsonSerializerOptions { WriteIndented = true });
        _testResult = s[..Math.Min(4000, s.Length)];
    }
}
