@page "/dashboard/providers"
@inject Api Api
@inject Loc Loc
@inject NavigationManager Nav

<div class="flex between">
    <div>
        <h1 class="page-title">@Loc.T("providers.title", "Providers")</h1>
        <p class="page-desc">@Loc.T("providers.subtitle", "Provider catalog — pick a provider to manage connections")</p>
    </div>
    <div class="flex gap-2">
        <button class="btn" @onclick="OpenBulk">
            <span class="material-symbols-outlined" style="font-size:17px">upload</span>
            @Loc.T("providers.bulkImport", "Bulk import")
        </button>
        <button class="btn btn-primary" @onclick="() => _nodeModal = true">
            <span class="material-symbols-outlined" style="font-size:17px">add</span>
            @Loc.T("providers.customNode", "Custom endpoint")
        </button>
    </div>
</div>

<div class="mt-4 flex gap-2" style="max-width:440px">
    <input class="input" placeholder="@Loc.T("providers.search", "Search providers…")" @bind="_q" @bind:event="oninput" />
</div>

<div class="tabs mt-4" style="flex-wrap:wrap">
    <button class="tab @(_conn is null ? "on" : "")" @onclick="() => _conn = null">
        @Loc.T("providers.all", "All") <span class="muted">@All().Count()</span>
    </button>
    <button class="tab @(_conn == true ? "on" : "")" @onclick="() => _conn = true">
        @Loc.T("providers.connected", "Connected") <span class="muted">@All().Count(p => p.Connected)</span>
    </button>
    <button class="tab @(_conn == false ? "on" : "")" @onclick="() => _conn = false">
        @Loc.T("providers.notConnected", "Not connected") <span class="muted">@All().Count(p => !p.Connected)</span>
    </button>
</div>

<div class="tabs mt-4" style="flex-wrap:wrap">
    <button class="tab @(_cat is null ? "on" : "")" @onclick="() => _cat = null">
        @Loc.T("providers.allCats", "All categories") <span class="muted">@All().Count()</span>
    </button>
    @foreach (var c in Categories())
    {
        <button class="tab @(_cat == c ? "on" : "")" @onclick="() => _cat = c">
            @CatLabel(c) <span class="muted">@All().Count(p => p.Category == c)</span>
        </button>
    }
</div>

@if (_cat is null && _conn is null)
{
    @foreach (var s in Sections())
    {
        <h2 class="page-title mt-6" style="font-size:15px">@s.Title <span class="muted sm">@s.Providers.Length</span></h2>
        <div class="pgrid mt-2">
            @foreach (var p in s.Providers)
            {
                @Tile(p)
            }
            @if (s.Providers.Length == 0)
            {
                <div class="empty"><span class="material-symbols-outlined">cloud_off</span>@Loc.T("providers.none", "No providers match")</div>
            }
        </div>
    }
}
else
{
    <div class="pgrid mt-4">
        @foreach (var p in Filtered())
        {
            @Tile(p)
        }
        @if (!Filtered().Any())
        {
            <div class="empty"><span class="material-symbols-outlined">cloud_off</span>@Loc.T("providers.none", "No providers match")</div>
        }
    </div>
}

@if (_nodes.Count > 0)
{
    <h2 class="page-title mt-6" style="font-size:15px">@Loc.T("providers.nodes", "Custom endpoints")</h2>
    <div class="card scroll-x mt-4">
        <table class="table">
            <thead><tr><th>@Loc.T("providers.name", "Name")</th><th>ID</th><th>@Loc.T("providers.kind", "Kind")</th><th>Base URL</th><th></th></tr></thead>
            <tbody>
                @foreach (var n in _nodes)
                {
                    <tr>
                        <td>@n.Name</td>
                        <td class="mono xs"><a class="link" href="/dashboard/providers/@n.Id">@n.Id</a></td>
                        <td class="muted sm">@n.Type</td>
                        <td class="mono sm muted">@n.BaseUrl</td>
                        <td><button class="btn btn-sm btn-danger" @onclick="() => DeleteNode(n.Id)">@Loc.T("common.delete", "Delete")</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_nodeModal)
{
    <div class="modal-back" @onclick="() => _nodeModal = false">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-head"><span class="modal-title">@Loc.T("providers.customNode", "Custom endpoint")</span>
                <button class="icon-btn" @onclick="() => _nodeModal = false"><span class="material-symbols-outlined" style="font-size:17px">close</span></button>
            </div>
            <div class="modal-body">
                <label class="lbl">@Loc.T("providers.kind", "Kind")</label>
                <select class="input" @bind="_nodeKind">
                    <option value="openai-compatible-chat">openai-compatible (chat completions)</option>
                    <option value="openai-compatible-responses">openai-compatible (responses api)</option>
                    <option value="anthropic-compatible">anthropic-compatible</option>
                    <option value="claude-code">claude-code</option>
                </select>
                <div class="mt-4">
                    <label class="lbl">@Loc.T("providers.name", "Name")</label>
                    <input class="input" @bind="_nodeName" />
                </div>
                <div class="mt-4">
                    <label class="lbl">Base URL</label>
                    <input class="input mono" @bind="_nodeBaseUrl" placeholder="http://localhost:8080" />
                </div>
                <div class="mt-4">
                    <label class="lbl">@Loc.T("providers.modelsList", "Models (comma-separated, optional)")</label>
                    <input class="input mono" @bind="_nodeModels" placeholder="llama3.2, qwen3" />
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn" @onclick="() => _nodeModal = false">@Loc.T("common.cancel", "Cancel")</button>
                <button class="btn btn-primary" @onclick="CreateNode" disabled="@(string.IsNullOrEmpty(_nodeBaseUrl))">@Loc.T("common.create", "Create")</button>
            </div>
        </div>
    </div>
}

@if (_bulkModal)
{
    <div class="modal-back" @onclick="CloseBulk">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-head"><span class="modal-title">@Loc.T("providers.bulkImport", "Bulk import")</span>
                <button class="icon-btn" @onclick="CloseBulk"><span class="material-symbols-outlined" style="font-size:17px">close</span></button>
            </div>
            <div class="modal-body">
                <label class="lbl">@Loc.T("providers.provider", "Provider")</label>
                <select class="input" @bind="_bulkProvider">
                    @foreach (var p in _providers.OrderBy(p => p.Name ?? p.Id))
                    {
                        <option value="@p.Id">@(p.Name ?? p.Id)</option>
                    }
                </select>
                <div class="mt-4">
                    <label class="lbl">@Loc.T("providers.keysPerLine", "API keys (one per line)")</label>
                    <textarea class="input mono" rows="6" @bind="_bulkKeys" placeholder="sk-..."></textarea>
                </div>
                @if (_bulkResults is not null)
                {
                    <div class="card card-p mt-4" style="max-height:200px;overflow:auto">
                        @foreach (var r in _bulkResults)
                        {
                            <div class="flex gap-2 sm" style="align-items:center">
                                <span class="badge @(r.Ok ? "ok" : "err")">@(r.Ok ? "ok" : "fail")</span>
                                <span class="mono">@r.Masked</span>
                                <span class="muted">@(r.Name ?? r.Error)</span>
                            </div>
                        }
                    </div>
                    <p class="muted sm mt-2">@_bulkCreated / @_bulkTotal @Loc.T("providers.imported", "imported")</p>
                }
            </div>
            <div class="modal-foot">
                <button class="btn" @onclick="CloseBulk">@Loc.T("common.close", "Close")</button>
                <button class="btn btn-primary" @onclick="BulkImport" disabled="@(_bulkBusy || string.IsNullOrEmpty(_bulkProvider) || string.IsNullOrWhiteSpace(_bulkKeys))">
                    @(_bulkBusy ? Loc.T("providers.importing", "Importing…") : Loc.T("common.import", "Import"))
                </button>
            </div>
        </div>
    </div>
}

@code {
    private record P(string Id, string? Name, string? Icon, string? TextIcon, string? Color, string Category, bool Backend, bool Connected, int ConnectionCount);
    private record Conn(string Id, string? Name, bool IsActive);
    private record Section(string Title, P[] Providers);
    private record Node(string Id, string? Name, string? Type, string? BaseUrl);
    private record BulkResult(int Index, bool Ok, string Masked, string? Name, string? Error);
    private List<P> _providers = [];
    private List<Node> _nodes = [];
    private string _q = "";
    private string? _cat;
    private bool? _conn;
    private string? _expanded;
    private List<Conn> _expandedConns = [];
    private bool _nodeModal;
    private string _nodeKind = "openai-compatible-chat", _nodeName = "", _nodeBaseUrl = "", _nodeModels = "";
    private bool _bulkModal, _bulkBusy;
    private string _bulkProvider = "", _bulkKeys = "";
    private List<BulkResult>? _bulkResults;
    private int _bulkCreated, _bulkTotal;

    protected override async Task OnInitializedAsync()
    {
        await LoadNodes();
        var r = await Api.GetAsync("api/providers");
        foreach (var grp in r.GetProperty("categories").EnumerateArray())
        {
            var kind = grp.GetProperty("kind").GetString() ?? "";
            foreach (var p in grp.GetProperty("providers").EnumerateArray())
            {
                _providers.Add(new P(
                    p.GetProperty("id").GetString()!,
                    p.TryGetProperty("name", out var n) ? n.GetString() : null,
                    p.TryGetProperty("icon", out var i) ? i.GetString() : null,
                    p.TryGetProperty("textIcon", out var ti) ? ti.GetString() : null,
                    p.TryGetProperty("color", out var c) && c.ValueKind == JsonValueKind.String ? c.GetString() : null,
                    kind,
                    p.GetProperty("backend").GetBoolean(),
                    p.GetProperty("connected").GetBoolean(),
                    p.GetProperty("connectionCount").GetInt32()));
            }
        }
    }

    private void OpenBulk()
    {
        _bulkModal = true;
        _bulkResults = null;
        _bulkKeys = "";
        if (string.IsNullOrEmpty(_bulkProvider))
            _bulkProvider = _providers.OrderBy(p => p.Name ?? p.Id).FirstOrDefault()?.Id ?? "";
    }

    private void CloseBulk() { _bulkModal = false; _bulkResults = null; }

    private async Task BulkImport()
    {
        _bulkBusy = true;
        try
        {
            var keys = _bulkKeys.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var r = await Api.PostAsync("api/providers/bulk", new { provider = _bulkProvider, keys });
            _bulkCreated = r.TryGetProperty("created", out var cr) ? cr.GetInt32() : 0;
            _bulkTotal = r.TryGetProperty("total", out var t) ? t.GetInt32() : keys.Length;
            _bulkResults = r.TryGetProperty("results", out var rs)
                ? rs.EnumerateArray().Select(x => new BulkResult(
                    x.GetProperty("index").GetInt32(),
                    x.GetProperty("ok").GetBoolean(),
                    x.TryGetProperty("masked", out var m) ? m.GetString() ?? "" : "",
                    x.TryGetProperty("name", out var n) ? n.GetString() : null,
                    x.TryGetProperty("error", out var e) ? e.GetString() : null)).ToList()
                : [];
        }
        finally { _bulkBusy = false; }
    }

    private async Task LoadNodes()
    {
        var r = await Api.GetAsync("api/provider-nodes");
        _nodes = r.GetProperty("nodes").EnumerateArray().Select(n =>
        {
            string? bu = null;
            if (n.TryGetProperty("data", out var d) && d.GetString() is { Length: > 0 } ds)
                try { bu = JsonDocument.Parse(ds).RootElement.TryGetProperty("baseUrl", out var b) ? b.GetString() : null; } catch { }
            return new Node(n.GetProperty("id").GetString()!,
                n.TryGetProperty("name", out var nm) ? nm.GetString() : null,
                n.TryGetProperty("type", out var t) ? t.GetString() : null, bu);
        }).ToList();
    }

    private async Task CreateNode()
    {
        var models = _nodeModels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(m => (object)new { id = m }).ToList();
        var data = new Dictionary<string, object> { ["baseUrl"] = _nodeBaseUrl };
        if (models.Count > 0) data["models"] = models;
        await Api.PostAsync("api/provider-nodes", new { kind = _nodeKind, name = _nodeName, data });
        _nodeModal = false;
        _nodeName = _nodeBaseUrl = _nodeModels = "";
        await LoadNodes();
    }

    private async Task DeleteNode(string id) { await Api.DeleteAsync($"api/provider-nodes/{id}"); await LoadNodes(); }

    private IEnumerable<P> All() => _providers;
    private IEnumerable<string> Categories() => _providers.Select(p => p.Category).Distinct().OrderBy(c => c);
    private IEnumerable<P> Filtered() => _providers
        .Where(p => _cat is null || p.Category == _cat)
        .Where(p => _conn is null || p.Connected == _conn)
        .Where(p => string.IsNullOrWhiteSpace(_q)
            || p.Id.Contains(_q, StringComparison.OrdinalIgnoreCase)
            || (p.Name ?? "").Contains(_q, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(p => p.Connected).ThenBy(p => p.Name ?? p.Id, StringComparer.OrdinalIgnoreCase);

    private static readonly Dictionary<string, string> CatLabels = new(StringComparer.Ordinal)
    {
        ["APIKEY_PROVIDERS"] = "API Key", ["OAUTH_PROVIDERS"] = "OAuth",
        ["NOAUTH_PROVIDERS"] = "No-Auth", ["LOCAL_PROVIDERS"] = "Local",
        ["UPSTREAM_PROXY_PROVIDERS"] = "Upstream Proxy", ["WEB_COOKIE_PROVIDERS"] = "Web Cookie",
        ["AUDIO_ONLY_PROVIDERS"] = "Audio", ["SEARCH_PROVIDERS"] = "Search",
        ["SYSTEM_PROVIDERS"] = "System", ["CLOUD_AGENT_PROVIDERS"] = "Cloud Agent",
    };
    private static string CatLabel(string c) => CatLabels.TryGetValue(c, out var l) ? l : c;

    private Section[] Sections()
    {
        var f = Filtered().ToArray();
        P[] Pick(string cat) => f.Where(p => p.Category == cat).ToArray();
        return
        [
            new(Loc.T("providers.secApi", "API Key Compatible Providers"), Pick("APIKEY_PROVIDERS")),
            new(Loc.T("providers.secOauth", "OAuth Providers"), Pick("OAUTH_PROVIDERS")),
            new(Loc.T("providers.secOther", "Other Providers"),
                f.Where(p => p.Category is not "APIKEY_PROVIDERS" and not "OAUTH_PROVIDERS").ToArray()),
        ];
    }

    private async Task ToggleExpand(P p)
    {
        if (_expanded == p.Id) { _expanded = null; _expandedConns = []; return; }
        _expanded = p.Id;
        _expandedConns = [];
        try
        {
            var r = await Api.GetAsync("api/provider-connections");
            _expandedConns = r.GetProperty("connections").EnumerateArray()
                .Where(c => c.GetProperty("provider").GetString() == p.Id)
                .Select(c => new Conn(c.GetProperty("id").GetString()!,
                    c.TryGetProperty("name", out var n) ? n.GetString() : null,
                    c.TryGetProperty("isActive", out var a) && a.GetBoolean())).ToList();
        }
        catch { }
    }

    private RenderFragment Tile(P p) => __builder =>
    {
        <div>
            <button class="pcard" @onclick='() => Nav.NavigateTo($"/dashboard/providers/{p.Id}")'>
                <span class="pcard-icon" style="@(p.Color is not null ? $"color:{p.Color}" : "")">
                    @if (p.Icon is not null)
                    {
                        <span class="material-symbols-outlined" style="font-size:22px">@p.Icon</span>
                    }
                    else
                    {
                        <span class="pcard-txt">@(p.TextIcon ?? (p.Name ?? p.Id)[..Math.Min(3, (p.Name ?? p.Id).Length)].ToUpperInvariant())</span>
                    }
                </span>
                <span class="pcard-body">
                    <span class="pcard-name">@(p.Name ?? p.Id)</span>
                    <span class="pcard-id mono xs muted">@p.Id</span>
                </span>
                @if (p.Connected)
                {
                    <span class="badge ok">@p.ConnectionCount</span>
                    <button class="icon-btn" style="width:26px;height:26px" @onclick="() => ToggleExpand(p)" @onclick:stopPropagation>
                        <span class="material-symbols-outlined" style="font-size:16px">@(_expanded == p.Id ? "expand_less" : "expand_more")</span>
                    </button>
                }
                else if (p.Backend)
                {
                    <span class="badge">API</span>
                }
            </button>
            @if (_expanded == p.Id)
            {
                <div class="card card-p" style="margin-top:4px">
                    @foreach (var c in _expandedConns)
                    {
                        <div class="flex between sm" style="padding:4px 0">
                            <span>@(c.Name ?? c.Id) <span class="badge @(c.IsActive ? "ok" : "err")">@(c.IsActive ? "active" : "off")</span></span>
                            <a class="link sm" href="/dashboard/providers/@p.Id">manage</a>
                        </div>
                    }
                    @if (_expandedConns.Count == 0)
                    {
                        <p class="muted sm" style="margin:0">…</p>
                    }
                </div>
            }
        </div>
    };
}
