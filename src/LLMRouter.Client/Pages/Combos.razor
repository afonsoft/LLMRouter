@page "/dashboard/combos"
@inject Api Api
@inject Loc Loc
@inject IJSRuntime JS

<div class="flex between">
    <div>
        <h1 class="page-title">@Loc.T("combos.title", "Combos")</h1>
        <p class="page-desc">@Loc.T("combos.subtitle", "Ordered model cascades with automatic fallback")</p>
    </div>
    <button class="btn btn-primary" @onclick="NewCombo">
        <span class="material-symbols-outlined" style="font-size:17px">add</span>
        @Loc.T("combos.new", "New combo")
    </button>
</div>

<div class="flex gap-2 mt-6">
    <button class="tab @(_tab == "combos" ? "on" : "")" @onclick='() => _tab = "combos"'>Combos</button>
    <button class="tab @(_tab == "aliases" ? "on" : "")" @onclick='() => _tab = "aliases"'>@Loc.T("combos.aliases", "Model aliases")</button>
    <button class="tab @(_tab == "mappings" ? "on" : "")" @onclick='() => _tab = "mappings"'>@Loc.T("combos.mappings", "Model → combo mappings")</button>
</div>

@if (_tab == "combos")
{
    @* SPEC-119: dismissible 3-step onboarding, upstream "Getting Started". *@
    @if (!_onboardDismissed)
    {
        <div class="card card-p mt-4">
            <div class="flex between">
                <div class="bold">@Loc.T("combos.gettingStarted", "Getting Started with Combos")</div>
                <button class="btn btn-sm" @onclick="DismissOnboarding">@Loc.T("combos.dismiss", "Dismiss")</button>
            </div>
            <div class="grid grid-3 mt-4">
                <div class="col gap-2">
                    <span class="badge info">1</span>
                    <div class="sm">@Loc.T("combos.step1", "Add provider connections — combos route across them.")</div>
                </div>
                <div class="col gap-2">
                    <span class="badge info">2</span>
                    <div class="sm">@Loc.T("combos.step2", "Create a combo and order its model cascade.")</div>
                </div>
                <div class="col gap-2">
                    <span class="badge info">3</span>
                    <div class="sm">@Loc.T("combos.step3", "Point clients at the combo name as the model.")</div>
                </div>
            </div>
        </div>
    }
    @* SPEC-119: alert banners row — missing default combo + health issues. *@
    @if (!string.IsNullOrEmpty(_defaultCombo) && !_combos.Any(c => c.Name == _defaultCombo))
    {
        <div class="card card-p mt-4" style="border-left:3px solid var(--amber,#f5a524)">
            <div class="flex gap-2 items-center">
                <span class="material-symbols-outlined" style="font-size:18px;color:var(--amber,#f5a524)">warning</span>
                <div class="sm">@Loc.T("combos.missingDefault", $"Default combo '{_defaultCombo}' is not defined — requests without a model will fail.")</div>
            </div>
        </div>
    }
    @if (_healthIssues > 0)
    {
        <div class="card card-p mt-4" style="border-left:3px solid var(--amber,#f5a524)">
            <div class="flex gap-2 items-center">
                <span class="material-symbols-outlined" style="font-size:18px;color:var(--amber,#f5a524)">monitor_heart</span>
                <div class="sm">@Loc.T("combos.healthIssues", $"Health Agent: {_healthIssues} combo issue(s) detected — see Analytics → Combo health.")</div>
            </div>
        </div>
    }
    <div class="flex gap-2 mt-4 items-center" style="flex-wrap:wrap">
        <div class="seg">
            <button class="seg-btn @(_kind == "all" ? "on" : "")" @onclick='() => _kind = "all"'>@Loc.T("combos.all", "All") @_combos.Count</button>
            <button class="seg-btn @(_kind == "intelligent" ? "on" : "")" @onclick='() => _kind = "intelligent"'>@Loc.T("combos.intelligent", "Intelligent") @_combos.Count(c => IsIntelligent(c.Kind))</button>
            <button class="seg-btn @(_kind == "deterministic" ? "on" : "")" @onclick='() => _kind = "deterministic"'>@Loc.T("combos.deterministic", "Deterministic") @_combos.Count(c => !IsIntelligent(c.Kind))</button>
        </div>
        <input class="input" style="max-width:260px" placeholder="@Loc.T("combos.search", "Search combos…")" @bind="_q" @bind:event="oninput" />
    </div>
    <div class="card card-p mt-4">
        <div class="flex between">
            <div class="bold">@Loc.T("combos.defaults", "Defaults")</div>
        </div>
        <div class="flex gap-2 mt-2 items-end">
            <div class="col">
                <label class="muted sm">@Loc.T("combos.defaultCombo", "Default combo (empty model)")</label>
                <select @bind="_defaultCombo">
                    <option value="">—</option>
                    @foreach (var c in _combos) { <option value="@c.Name">@c.Name</option> }
                </select>
            </div>
            <div class="col">
                <label class="muted sm">@Loc.T("combos.handoffModel", "Handoff model")</label>
                <input @bind="_handoffModel" placeholder="provider/model" />
            </div>
            <button class="btn btn-sm" @onclick="SaveDefaults">@Loc.T("common.save", "Save")</button>
        </div>
    </div>
    <div class="card card-p mt-4">
        <div class="flex between"><div class="bold">@Loc.T("combos.autoCatalog", "Auto-routing catalog")</div></div>
        <div class="muted sm mt-2">@Loc.T("combos.autoHint", "Virtual combos resolved live from the candidate pool — usable as model auto/x")</div>
        @foreach (var a in _autoCombos)
        {
            <div class="flex between mt-2 items-center">
                <div>
                    <span class="mono sm bold">@a.Id</span>
                    <span class="badge info ml-2">@a.Count models</span>
                    <div class="muted sm">@a.Description</div>
                </div>
                <div class="flex gap-2 items-center">
                    <input @bind="_dupNames[a.Id]" placeholder="@Loc.T("combos.dupName", "new combo name")" style="width:140px" />
                    <button class="btn btn-sm" @onclick="() => Duplicate(a.Id)">@Loc.T("combos.materialize", "Materialize")</button>
                </div>
            </div>
        }
    </div>
    <div class="grid grid-2 mt-4">
        @foreach (var c in CombosFiltered())
        {
            <div class="card card-p">
                <div class="flex between">
                    <div>
                        <div class="bold" style="font-size:15px">@c.Name</div>
                        <span class="badge info mt-2">@c.Kind</span>
                        @if (c.Kind == "round-robin" && c.StickyLimit > 1)
                        {
                            <span class="badge mt-2">sticky ×@c.StickyLimit</span>
                        }
                    </div>
                    <div class="flex gap-2">
                        <button class="btn btn-sm" title="Move up" @onclick="() => Move(c, -1)">↑</button>
                        <button class="btn btn-sm" title="Move down" @onclick="() => Move(c, 1)">↓</button>
                        <button class="btn btn-sm" @onclick="() => TestPool(c.Id!)">Test</button>
                        <a class="btn btn-sm" href="/dashboard/combos/live?id=@c.Id">Live</a>
                        <button class="btn btn-sm" @onclick="() => Edit(c)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => Delete(c.Id!)">Delete</button>
                    </div>
                </div>
                <div class="flex gap-2 mt-4" style="flex-wrap:wrap">
                    @foreach (var (m, i) in c.ModelsList.Select((x, i) => (x, i)))
                    {
                        <span class="chip" title="@m"><span class="muted xs">@(i + 1)</span> @m</span>
                    }
                </div>
                @if (_testResults.TryGetValue(c.Id ?? "", out var tr))
                {
                    @if (tr.Count == 0)
                    {
                        <div class="muted sm mt-2">@Loc.T("combos.poolEmpty", "pool empty — no active connections/models resolved")</div>
                    }
                    <div class="col gap-2 mt-2">
                        @foreach (var p in tr)
                        {
                            <div class="flex gap-2">
                                <span class="badge @(p.Ok ? "success" : "danger")">@(p.Ok ? "ok" : "no conn")</span>
                                <span class="mono sm">@p.Model</span>
                                @if (p.LastLatencyMs is not null) { <span class="muted sm">@p.LastLatencyMs ms</span> }
                            </div>
                        }
                    </div>
                }
            </div>
        }
        @if (_combos.Count == 0)
        {
            <div class="card"><div class="empty"><span class="material-symbols-outlined">layers</span>@Loc.T("combos.empty", "No combos yet")</div></div>
        }
        else if (!CombosFiltered().Any())
        {
            <div class="card"><div class="empty"><span class="material-symbols-outlined">search_off</span>@Loc.T("combos.noMatch", "No combos match this filter")</div></div>
        }
    </div>
}
else if (_tab == "aliases")
{
    <div class="card card-p mt-4">
        <div class="flex between">
            <div class="bold">@Loc.T("combos.aliases", "Model aliases")</div>
            <button class="btn btn-sm btn-primary" @onclick='() => _aliases.Add(new())'>+ Add</button>
        </div>
        <p class="dim sm mt-2">foo → provider/model — alias resolves through the gateway.</p>
        @foreach (var a in _aliases)
        {
            <div class="flex gap-2 mt-3">
                <input class="input mono" style="flex:1" @bind="a.Name" placeholder="alias" />
                <input class="input mono" style="flex:2" @bind="a.Target" placeholder="provider/model" />
                <button class="btn btn-sm btn-danger" @onclick="() => _aliases.Remove(a)">×</button>
            </div>
        }
        <div class="mt-4"><button class="btn btn-primary" @onclick="SaveAliases">@Loc.T("common.save", "Save")</button></div>
    </div>
}
else
{
    <div class="card card-p mt-4">
        <div class="flex between">
            <div class="bold">@Loc.T("combos.mappings", "Model → combo mappings")</div>
            <button class="btn btn-sm btn-primary" @onclick='() => _mappings.Add(new())'>+ Add</button>
        </div>
        <p class="dim sm mt-2">Upstream-facing model name routed to a combo automatically.</p>
        @foreach (var mp in _mappings)
        {
            <div class="flex gap-2 mt-3">
                <input class="input mono" style="flex:1" @bind="mp.Model" placeholder="gpt-4" />
                <select class="input" style="flex:2" @bind="mp.Combo">
                    @foreach (var c in _combos) { <option value="@c.Name">@c.Name</option> }
                </select>
                <button class="btn btn-sm btn-danger" @onclick="() => DeleteMapping(mp.Model)">×</button>
            </div>
        }
        <div class="mt-4"><button class="btn btn-primary" @onclick="SaveMappings">@Loc.T("common.save", "Save")</button></div>
    </div>
}

@if (_editing is not null)
{
    <div class="modal-back" @onclick="() => _editing = null">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-head"><span class="modal-title">@(_editing.Id is null ? Loc.T("combos.new", "New combo") : Loc.T("combos.edit", "Edit combo"))</span>
                <button class="icon-btn" @onclick="() => _editing = null"><span class="material-symbols-outlined" style="font-size:17px">close</span></button>
            </div>
            <div class="modal-body">
                <label class="lbl">@Loc.T("combos.name", "Name")</label>
                <input class="input mono" @bind="_editing.Name" placeholder="my-combo" />
                <div class="mt-4">
                    <label class="lbl">@Loc.T("combos.kind", "Strategy")</label>
                    <select class="input" @bind="_editing.Kind">
                        <option value="fallback">fallback (ordered)</option>
                        <option value="round-robin">round-robin</option>
                        <option value="weighted">weighted (model~N)</option>
                        <option value="random">random</option>
                        <option value="strict-random">strict-random</option>
                        <option value="least-used">least-used</option>
                        <option value="cost-optimized">cost-optimized</option>
                        <option value="p2c">p2c (power of two choices)</option>
                        <option value="quota-weighted">quota-weighted</option>
                        <option value="headroom">headroom</option>
                        <option value="reset-aware">reset-aware</option>
                        <option value="context-optimized">context-optimized</option>
                        <option value="cache-optimized">cache-optimized</option>
                        <option value="lkgp">lkgp (last known good)</option>
                        <option value="auto">auto</option>
                        <option value="fusion">fusion (fan-out + judge)</option>
                        <option value="pipeline">pipeline (chained)</option>
                        <option value="vision-adapter">vision-adapter (imageToText → llm)</option>
                    </select>
                </div>
                @if (_editing.Kind == "round-robin")
                {
                    <div class="mt-4">
                        <label class="lbl">Sticky limit (requests per model before rotating)</label>
                        <input class="input" type="number" min="1" @bind="_editing.StickyLimit" />
                    </div>
                }
                <div class="mt-4">
                    <label class="lbl">@Loc.T("combos.models", "Models (provider/model, one per line, in order)")</label>
                    <textarea class="input mono" rows="6" @bind="_modelsText" placeholder="openai/gpt-4o&#10;anthropic/claude-sonnet-4"></textarea>
                    @if (_editing.Kind == "vision-adapter")
                    {
                        <p class="dim sm mt-2">vision-adapter: first model describes the image, remaining models answer.</p>
                    }
                    @if (_editing.Kind == "weighted")
                    {
                        <p class="dim sm mt-2">weighted: append <code>~N</code> to a model ref to weight it (e.g. <code>openai/gpt-4o~3</code>).</p>
                    }
                    @if (_editing.Kind == "fusion")
                    {
                        <p class="dim sm mt-2">fusion: all members answer in parallel; prefix a member with <code>judge:</code> to make it synthesize the final answer (default judge = first member). Non-stream only.</p>
                    }
                    @if (_editing.Kind == "pipeline")
                    {
                        <p class="dim sm mt-2">pipeline: each model's output feeds the next one's input. Non-stream only.</p>
                    }
                </div>
            </div>
            <div class="modal-foot">
                <button class="btn" @onclick="() => _editing = null">@Loc.T("common.cancel", "Cancel")</button>
                <button class="btn btn-primary" @onclick="Save" disabled="@(string.IsNullOrWhiteSpace(_editing.Name))">@Loc.T("common.save", "Save")</button>
            </div>
        </div>
    </div>
}

@code {
    private sealed class ComboVm
    {
        public string? Id; public string Name = ""; public string Kind = "fallback";
        public int StickyLimit = 1;
        public List<string> ModelsList = [];
    }
    private sealed class AliasVm { public string Name = ""; public string Target = ""; }
    private sealed class MappingVm { public string Model = ""; public string Combo = ""; }

    private string _tab = "combos";
    private List<ComboVm> _combos = [];
    private List<AliasVm> _aliases = [];
    private List<MappingVm> _mappings = [];
    private ComboVm? _editing;
    private string _modelsText = "";
    private string _defaultCombo = "";
    private string _handoffModel = "";
    private Dictionary<string, List<PoolProbe>> _testResults = [];
    private List<AutoVm> _autoCombos = [];
    private Dictionary<string, string> _dupNames = [];
    private string _q = "";
    private string _kind = "all";
    private bool _onboardDismissed = true;
    private int _healthIssues;
    private sealed class AutoVm { public string Id = ""; public string Description = ""; public int Count; }

    private static readonly HashSet<string> IntelligentKinds = new(StringComparer.OrdinalIgnoreCase)
    {
        "auto", "fusion", "pipeline", "lkgp", "context-optimized", "context-relay",
        "cache-optimized", "cost-optimized", "quota-weighted", "reset-aware",
        "reset-window", "headroom", "p2c", "least-used",
    };
    private static bool IsIntelligent(string? kind) => kind is not null && IntelligentKinds.Contains(kind);

    private IEnumerable<ComboVm> CombosFiltered() => _combos.Where(c =>
        (_kind == "all" || (_kind == "intelligent") == IsIntelligent(c.Kind))
        && (string.IsNullOrWhiteSpace(_q) || c.Name.Contains(_q, StringComparison.OrdinalIgnoreCase)
            || c.ModelsList.Any(m => m.Contains(_q, StringComparison.OrdinalIgnoreCase))));

    private async Task DismissOnboarding()
    {
        _onboardDismissed = true;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "llmr_combos_onboarding", "1"); }
        catch (JSException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var v = await JS.InvokeAsync<string?>("localStorage.getItem", "llmr_combos_onboarding");
            _onboardDismissed = v == "1";
        }
        catch (JSException) { _onboardDismissed = false; }
        StateHasChanged();
    }
    private sealed class PoolProbe { public string Model = ""; public bool Ok; public long? LastLatencyMs; }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        var r = await Api.GetAsync("api/combos");
        _combos = r.GetProperty("combos").EnumerateArray().Select(c => new ComboVm
        {
            Id = c.GetProperty("id").GetString(),
            Name = c.GetProperty("name").GetString() ?? "",
            Kind = c.TryGetProperty("kind", out var k) ? k.GetString() ?? "fallback" : "fallback",
            StickyLimit = c.TryGetProperty("stickyLimit", out var sl) && sl.ValueKind == JsonValueKind.Number ? sl.GetInt32() : 1,
            ModelsList = c.TryGetProperty("models", out var m)
                ? JsonSerializer.Deserialize<List<string>>(m.GetRawText()) ?? [] : [],
        }).ToList();
        var cd = await Api.GetAsync("api/settings/combo-defaults");
        _defaultCombo = cd.TryGetProperty("defaultCombo", out var dcv) ? dcv.GetString() ?? "" : "";
        _handoffModel = cd.TryGetProperty("handoffModel", out var hmv) ? hmv.GetString() ?? "" : "";
        try
        {
            var ch = await Api.GetAsync("api/usage/combo-health");
            _healthIssues = ch.TryGetProperty("autopilot", out var ap)
                && ap.TryGetProperty("summary", out var sm)
                && sm.TryGetProperty("issueCount", out var ic)
                ? ic.GetInt32() : 0;
        }
        catch (HttpRequestException) { _healthIssues = 0; }
        var ac = await Api.GetAsync("api/combos/auto");
        _autoCombos = ac.GetProperty("combos").EnumerateArray().Select(x => new AutoVm
        {
            Id = x.GetProperty("id").GetString() ?? "",
            Description = x.TryGetProperty("description", out var dv) ? dv.GetString() ?? "" : "",
            Count = x.TryGetProperty("count", out var cv2) ? cv2.GetInt32() : 0,
        }).ToList();
        _dupNames = _autoCombos.ToDictionary(x => x.Id, _ => "");
        var ar = await Api.GetAsync("api/model-aliases");
        _aliases = ar.GetProperty("aliases").EnumerateObject()
            .Select(kv => new AliasVm { Name = kv.Name, Target = kv.Value.GetString() ?? "" }).ToList();
        var mr = await Api.GetAsync("api/model-combo-mappings");
        _mappings = mr.GetProperty("mappings").EnumerateObject()
            .Select(kv => new MappingVm { Model = kv.Name, Combo = kv.Value.GetString() ?? "" }).ToList();
    }

    private void NewCombo() { _editing = new ComboVm { Kind = "fallback" }; _modelsText = ""; }
    private void Edit(ComboVm c) { _editing = c; _modelsText = string.Join("\n", c.ModelsList); }

    private async Task Save()
    {
        var models = _modelsText.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        var payload = new { name = _editing!.Name, kind = _editing.Kind, stickyLimit = _editing.StickyLimit, models };
        if (_editing!.Id is null)
            await Api.PostAsync("api/combos", payload);
        else
            await Api.PutAsync($"api/combos/{_editing.Id}", payload);
        _editing = null;
        await Load();
    }

    private async Task Delete(string id) { await Api.DeleteAsync($"api/combos/{id}"); await Load(); }

    private async Task Move(ComboVm c, int dir)
    {
        var i = _combos.IndexOf(c);
        var j = i + dir;
        if (i < 0 || j < 0 || j >= _combos.Count) return;
        (_combos[i], _combos[j]) = (_combos[j], _combos[i]);
        await Api.PostAsync("api/combos/reorder", new { ids = _combos.Select(x => x.Id).ToList() });
    }

    private async Task TestPool(string id)
    {
        var r = await Api.PostAsync($"api/combos/{id}/test", new { });
        _testResults[id] = r.GetProperty("pool").EnumerateArray().Select(p => new PoolProbe
        {
            Model = p.GetProperty("model").GetString() ?? "",
            Ok = p.GetProperty("ok").GetBoolean(),
            LastLatencyMs = p.TryGetProperty("lastLatencyMs", out var l) && l.ValueKind == JsonValueKind.Number ? l.GetInt64() : null,
        }).ToList();
    }

    private async Task Duplicate(string autoId)
    {
        var name = _dupNames.GetValueOrDefault(autoId, "");
        if (string.IsNullOrWhiteSpace(name)) return;
        await Api.PostAsync("api/combos/duplicate", new { autoId, name });
        _dupNames[autoId] = "";
        await Load();
    }

    private async Task SaveDefaults()
    {
        await Api.PutAsync("api/settings/combo-defaults", new { defaultCombo = _defaultCombo, handoffModel = _handoffModel });
    }

    private async Task SaveAliases()
    {
        var map = _aliases.Where(a => !string.IsNullOrWhiteSpace(a.Name))
            .ToDictionary(a => a.Name, a => a.Target);
        await Api.PutAsync("api/model-aliases", new { aliases = map });
        await Load();
    }

    private async Task SaveMappings()
    {
        foreach (var mp in _mappings.Where(m => !string.IsNullOrWhiteSpace(m.Model) && !string.IsNullOrWhiteSpace(m.Combo)))
            await Api.PostAsync("api/model-combo-mappings", new { model = mp.Model, combo = mp.Combo });
        await Load();
    }

    private async Task DeleteMapping(string model)
    {
        await Api.DeleteAsync($"api/model-combo-mappings/{Uri.EscapeDataString(model)}");
        _mappings.RemoveAll(m => m.Model == model);
    }

    private ComboVm? _prev;

}
