@page "/dashboard/discovery"
@page "/dashboard/radar"
@page "/dashboard/gamification"
@page "/dashboard/leaderboard"
@page "/dashboard/free-tiers"
@page "/dashboard/free-provider-rankings"
@page "/dashboard/chaos"
@page "/dashboard/memory"
@page "/dashboard/webhooks"
@page "/dashboard/batch"
@page "/dashboard/batches"
@page "/dashboard/plugins"
@page "/dashboard/search-tools"
@page "/dashboard/audit"
@inject Api Api
@inject Loc Loc
@inject NavigationManager Nav

@{
    var section = Nav.Uri.Split('/').Last().Split('?')[0];
}

<h1 class="page-title">@_title</h1>
<p class="page-desc">@_subtitle</p>

@if (section is "discovery" or "radar")
{
    <button class="btn" @onclick="Scan">@Loc.T("extras.scan", "Scan local providers")</button>
    <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;margin-top:12px">
        @if (_discovered is not null)
        {
            @foreach (var d in _discovered)
            {
                <div class="card card-p">
                    <div class="bold">@d.GetProperty("name").GetString()</div>
                    <div class="muted xs">@d.GetProperty("baseUrl").GetString()</div>
                    <span class="badge @(d.GetProperty("detected").GetBoolean() ? "ok" : "")">
                        @(d.GetProperty("detected").GetBoolean() ? "detected" : "not found")
                    </span>
                </div>
            }
        }
    </div>
}
else if (section is "gamification" or "leaderboard")
{
    @if (_gam is not null)
    {
        <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px;margin-bottom:14px">
            <div class="card card-p"><div class="xs muted">XP</div><div class="bold" style="font-size:22px">@_gam.Value.GetProperty("xp").GetInt32()</div></div>
            <div class="card card-p"><div class="xs muted">Level</div><div class="bold" style="font-size:22px">@_gam.Value.GetProperty("level").GetString()</div></div>
            <div class="card card-p"><div class="xs muted">Requests</div><div class="bold" style="font-size:22px">@_gam.Value.GetProperty("requests").GetInt64()</div></div>
        </div>
        <div class="flex" style="gap:6px;flex-wrap:wrap;margin-bottom:14px">
            @foreach (var b in _gam.Value.GetProperty("badges").EnumerateArray())
            {
                <span class="badge ok">@b.GetString()</span>
            }
        </div>
    }
    @if (_board is not null)
    {
        <table class="tbl"><thead><tr><th>Model</th><th>Requests</th><th>Tokens</th></tr></thead>
        <tbody>
        @foreach (var r in _board)
        {
            <tr><td>@r.GetProperty("model").GetString()</td><td>@r.GetProperty("requests").GetInt64()</td><td>@r.GetProperty("tokens").GetInt64()</td></tr>
        }
        </tbody></table>
    }
}
else if (section is "free-tiers")
{
    <table class="tbl"><thead><tr><th>Provider</th><th>Connection</th><th>Active</th></tr></thead>
    <tbody>
    @if (_free is not null)
    {
        @foreach (var f in _free)
        {
            <tr><td>@f.GetProperty("provider").GetString()</td><td class="mono xs">@f.GetProperty("id").GetString()</td><td>@f.GetProperty("isActive").GetBoolean()</td></tr>
        }
    }
    </tbody></table>
}
else if (section is "free-provider-rankings")
{
    <table class="tbl"><thead><tr>
        <th>#</th><th>Provider</th><th>Score</th><th>Availability</th><th>Success</th>
        <th>Avg latency</th><th>Connections</th><th>Breaker</th><th>Cooldown</th>
    </tr></thead>
    <tbody>
    @if (_free is not null)
    {
        @foreach (var f in _free)
        {
            <tr>
                <td class="muted xs">@f.GetProperty("rank").GetInt32()</td>
                <td>@f.GetProperty("provider").GetString()</td>
                <td class="mono">@f.GetProperty("score").GetDouble()</td>
                <td>@(f.GetProperty("availability").GetDouble())%</td>
                <td>@(f.GetProperty("successRate").GetDouble())%</td>
                <td class="muted xs">@(f.GetProperty("avgLatencyMs").GetInt64())ms</td>
                <td class="muted xs">@f.GetProperty("activeConnections").GetInt32()/@f.GetProperty("connections").GetInt32()</td>
                <td class="muted xs">@f.GetProperty("breaker").GetString()</td>
                <td class="muted xs">@(f.GetProperty("cooldownSec").GetInt32())s</td>
            </tr>
        }
    }
    </tbody></table>
}
else if (section is "chaos")
{
    <div class="card card-p" style="max-width:420px">
        <div class="flex" style="gap:10px;align-items:center">
            <label>Error %</label><input class="input" type="number" style="width:80px" @bind="_errorPct" />
            <label>Latency ms</label><input class="input" type="number" style="width:100px" @bind="_latencyMs" />
            <button class="btn" @onclick="SaveChaos">@Loc.T("common.save", "Save")</button>
        </div>
        <p class="muted xs" style="margin-top:8px">@Loc.T("extras.chaosHint", "Fault injection applies to gateway requests")</p>
    </div>
}
else if (section is "memory")
{
    <div class="card card-p" style="margin-bottom:10px;display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        <span class="xs muted">backend</span>
        <select class="inp xs" @bind="_memBackend">
            <option value="kv">kv</option><option value="obsidian">obsidian</option><option value="notion">notion</option>
        </select>
        @if (_memBackend == "obsidian")
        {
            <input class="inp xs mono" style="flex:1;min-width:200px" placeholder="vault path" @bind="_obsVault" />
        }
        @if (_memBackend == "notion")
        {
            <input class="inp xs mono" style="width:200px" placeholder="parent page/database id" @bind="_notParent" />
            <input class="inp xs mono" style="flex:1;min-width:160px" type="password" placeholder="integration token" @bind="_notToken" />
        }
        <button class="btn xs" @onclick="SaveBackend">@Loc.T("common.save", "Save")</button>
    </div>
    <div class="flex" style="gap:8px;margin-bottom:10px">
        <input class="input" style="flex:1" @bind="_memContent" placeholder="memory content…" />
        <input class="input" style="width:160px" @bind="_memTags" placeholder="tags" />
        <button class="btn" @onclick="AddMemory">@Loc.T("common.add", "Add")</button>
        <input class="input" style="width:160px" @bind="_memQ" placeholder="search" @bind:event="oninput" @bind:after="LoadMemory" />
    </div>
    @if (_memory is not null)
    {
        @foreach (var m in _memory)
        {
            <div class="card card-p" style="margin-bottom:6px">
                <div>@m.GetProperty("content").GetString()</div>
                <div class="muted xs">@m.GetProperty("at").GetString() @(m.TryGetProperty("tags", out var tg) ? tg.GetString() : "")
                    <a style="cursor:pointer" @onclick='() => DelMemory(m.GetProperty("id").GetString()!)'> ✕</a>
                </div>
            </div>
        }
    }
}
else if (section is "webhooks")
{
    <div class="flex" style="gap:8px;margin-bottom:10px">
        <input class="input" style="flex:1" @bind="_whUrl" placeholder="https://…/hook" />
        <input class="input" style="width:160px" @bind="_whEvents" placeholder="events (comma, * = all)" />
        <button class="btn" @onclick="AddWebhook">@Loc.T("common.add", "Add")</button>
    </div>
    @if (_hooks is not null)
    {
        @foreach (var w in _hooks)
        {
            <div class="card card-p" style="margin-bottom:6px">
                <code>@w.GetProperty("url").GetString()</code>
                <span class="muted xs"> — @string.Join(",", w.GetProperty("events").EnumerateArray().Select(e => e.GetString()))
                    <a style="cursor:pointer" @onclick='() => DelWebhook(w.GetProperty("id").GetString()!)'> ✕</a></span>
            </div>
        }
    }
}
else if (section is "batch" or "batches")
{
    <p class="muted">POST <code>/api/batches</code> with <code>{"requests":[…chat bodies…]}</code></p>
    @if (_batches is not null)
    {
        <table class="tbl"><thead><tr><th>Id</th><th>Status</th><th>Total</th></tr></thead>
        <tbody>
        @foreach (var b in _batches)
        {
            <tr><td class="mono xs">@b.GetProperty("id").GetString()</td><td>@b.GetProperty("status").GetString()</td><td>@b.GetProperty("total").GetInt32()</td></tr>
        }
        </tbody></table>
    }
}
else if (section is "audit")
{
    <table class="tbl"><thead><tr><th>At</th><th>Action</th><th>Detail</th></tr></thead>
    <tbody>
    @if (_audit is not null)
    {
        @foreach (var a in _audit)
        {
            <tr><td class="muted xs">@a.GetProperty("at").GetString()</td><td>@a.GetProperty("action").GetString()</td><td class="muted xs">@a.GetProperty("detail").GetString()</td></tr>
        }
    }
    </tbody></table>
}
else if (section is "plugins")
{
    <h3 class="bold">Bundled skills</h3>
    @if (_plugins is not null)
    {
        <div class="flex" style="gap:6px;flex-wrap:wrap;margin-bottom:12px">
            @foreach (var sk in _plugins.Value.GetProperty("skills").EnumerateArray())
            {
                <span class="badge ok">@sk.GetString()</span>
            }
        </div>
        <h3 class="bold">MCP servers</h3>
        @foreach (var m in _plugins.Value.GetProperty("mcpServers").EnumerateArray())
        {
            <div class="card card-p" style="margin-bottom:6px"><code class="xs">@m.ToString()</code></div>
        }
        <h3 class="bold" style="margin-top:16px">Registered plugins</h3>
        <p class="muted xs">Gateway hooks: <code>{"on":"onRequest|onResponse","action":"setModel|addHeaders|annotate","value":…}</code></p>
        @if (_plugins.Value.TryGetProperty("registered", out var reg))
        {
            <table class="tbl"><tbody>
            @foreach (var p in reg.EnumerateArray())
            {
                <tr>
                    <td class="bold">@p.GetProperty("name").GetString()</td>
                    <td class="mono xs muted">@p.GetProperty("id").GetString()</td>
                    <td><button class="btn xs" @onclick='() => TogglePlugin(p)'>@(p.TryGetProperty("enabled", out var en) && en.GetBoolean() ? "on" : "off")</button></td>
                    <td><button class="btn xs danger" @onclick='() => DelPlugin(p.GetProperty("id").GetString()!)'>×</button></td>
                </tr>
                <tr><td colspan="4" class="mono xs muted" style="padding-top:0">@p.GetProperty("hooks").ToString()</td></tr>
            }
            </tbody></table>
        }
        <div class="card card-p" style="margin-top:10px;display:flex;gap:6px;flex-wrap:wrap;align-items:center">
            <input class="inp xs" placeholder="name" @bind="_plName" style="width:140px" />
            <input class="inp xs mono" placeholder='hooks JSON [{"on":"onRequest","action":"annotate"}]' @bind="_plHooks" style="flex:1;min-width:220px" />
            <button class="btn xs" @onclick="AddPlugin">Add plugin</button>
        </div>
    }
}
else if (section is "search-tools")
{
    <table class="tbl"><thead><tr><th>Tool</th><th>Endpoint</th><th></th></tr></thead>
    <tbody>
    @if (_tools is not null)
    {
        @foreach (var t in _tools)
        {
            <tr><td class="bold">@t.GetProperty("name").GetString()</td><td class="mono xs">@t.GetProperty("endpoint").GetString()</td><td class="muted xs">@t.GetProperty("desc").GetString()</td></tr>
        }
    }
    </tbody></table>
    <h3 class="bold" style="margin-top:16px">Registered tools</h3>
    @if (_regTools is not null)
    {
        <table class="tbl"><tbody>
        @foreach (var t in _regTools)
        {
            <tr>
                <td class="bold">@t.GetProperty("name").GetString()</td>
                <td class="xs">@t.GetProperty("kind").GetString()</td>
                <td class="mono xs muted">@(t.TryGetProperty("url", out var u) ? u.GetString() : "")</td>
                <td><button class="btn xs" @onclick='() => ToggleRegTool(t)'>@(t.TryGetProperty("enabled", out var en) && en.GetBoolean() ? "on" : "off")</button></td>
                <td><button class="btn xs danger" @onclick='() => DelRegTool(t.GetProperty("id").GetString()!)'>×</button></td>
            </tr>
        }
        </tbody></table>
    }
    <div class="card card-p" style="margin-top:10px;display:flex;gap:6px;flex-wrap:wrap;align-items:center">
        <input class="inp xs" placeholder="name" @bind="_stName" style="width:120px" />
        <select class="inp xs" @bind="_stKind"><option value="webFetch">webFetch</option><option value="search">search</option></select>
        <input class="inp xs mono" placeholder="url" @bind="_stUrl" style="flex:1;min-width:160px" />
        <button class="btn xs" @onclick="AddRegTool">Add tool</button>
    </div>
}
else
{
    <p class="muted">@Loc.T("extras.none", "Nothing here yet — this page is reserved by the spec.")</p>
}

@code {
    private string _title = "", _subtitle = "";
    private JsonElement[]? _discovered, _board, _free, _memory, _hooks, _batches, _audit, _tools;
    private JsonElement? _gam, _plugins;
    private int _errorPct, _latencyMs;
    private string _memContent = "", _memTags = "", _memQ = "", _whUrl = "", _whEvents = "*";
    private string _plName = "", _plHooks = "", _stName = "", _stKind = "webFetch", _stUrl = "";
    private string _memBackend = "kv", _obsVault = "", _notParent = "", _notToken = "";
    private JsonElement[]? _regTools;

    protected override async Task OnParametersSetAsync()
    {
        var section = Nav.Uri.Split('/').Last().Split('?')[0];
        _title = section; _subtitle = Loc.T($"extras.{section}", "");
        switch (section)
        {
            case "discovery": case "radar": await Scan(); break;
            case "gamification": case "leaderboard":
                _gam = await Api.GetAsync("api/gamification");
                _board = (await Api.GetAsync("api/leaderboard")).GetProperty("leaderboard").EnumerateArray().ToArray();
                break;
            case "free-tiers":
                _free = (await Api.GetAsync("api/free-tiers")).GetProperty("providers").EnumerateArray().ToArray();
                break;
            case "free-provider-rankings":
                _free = (await Api.GetAsync("api/free-provider-rankings")).GetProperty("providers").EnumerateArray().ToArray();
                break;
            case "chaos":
                var c = await Api.GetAsync("api/chaos");
                _errorPct = c.TryGetProperty("errorPct", out var e) ? e.GetInt32() : 0;
                _latencyMs = c.TryGetProperty("latencyMs", out var l) ? l.GetInt32() : 0;
                break;
            case "memory": await LoadMemory(); await LoadBackend(); break;
            case "webhooks":
                _hooks = (await Api.GetAsync("api/webhooks")).GetProperty("webhooks").EnumerateArray().ToArray();
                break;
            case "batch": case "batches":
                _batches = (await Api.GetAsync("api/batches")).GetProperty("batches").EnumerateArray().ToArray();
                break;
            case "audit":
                _audit = (await Api.GetAsync("api/audit")).GetProperty("events").EnumerateArray().ToArray();
                break;
            case "plugins":
                _plugins = await Api.GetAsync("api/plugins");
                break;
            case "search-tools":
                _tools = (await Api.GetAsync("api/search-tools")).GetProperty("tools").EnumerateArray().ToArray();
                await LoadRegTools();
                break;
        }
    }

    private async Task Scan() =>
        _discovered = (await Api.GetAsync("api/discovery")).GetProperty("providers").EnumerateArray().ToArray();

    private async Task SaveChaos() => await Api.PostAsync("api/chaos", new { errorPct = _errorPct, latencyMs = _latencyMs });

    private async Task LoadMemory() =>
        _memory = (await Api.GetAsync("api/memory" + (_memQ == "" ? "" : $"?q={Uri.EscapeDataString(_memQ)}")))
            .GetProperty("items").EnumerateArray().ToArray();

    private async Task AddMemory()
    {
        if (_memContent == "") return;
        await Api.PostAsync("api/memory", new { content = _memContent, tags = _memTags });
        _memContent = ""; await LoadMemory();
    }

    private async Task DelMemory(string id)
    { await Api.PostAsync("api/memory", new { id }); await LoadMemory(); }

    private async Task LoadBackend()
    {
        var b = await Api.GetAsync("api/memory/backend");
        _memBackend = b.TryGetProperty("backend", out var be) ? be.GetString() ?? "kv" : "kv";
        if (b.TryGetProperty("obsidian", out var ob) && ob.TryGetProperty("vaultPath", out var v))
            _obsVault = v.GetString() ?? "";
        if (b.TryGetProperty("notion", out var no) && no.TryGetProperty("parentId", out var p))
            _notParent = p.GetString() ?? "";
    }

    private async Task SaveBackend()
    {
        await Api.PostAsync("api/memory/backend", new
        {
            backend = _memBackend,
            obsidian = new { vaultPath = _obsVault },
            notion = new { token = _notToken, parentId = _notParent },
        });
        _notToken = "";
        await LoadMemory();
    }

    private async Task AddWebhook()
    {
        if (_whUrl == "") return;
        await Api.PostAsync("api/webhooks", new { url = _whUrl, events = _whEvents.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) });
        _whUrl = "";
        _hooks = (await Api.GetAsync("api/webhooks")).GetProperty("webhooks").EnumerateArray().ToArray();
    }

    private async Task DelWebhook(string id)
    {
        await Api.PostAsync("api/webhooks", new { id });
        _hooks = (await Api.GetAsync("api/webhooks")).GetProperty("webhooks").EnumerateArray().ToArray();
    }

    private async Task AddPlugin()
    {
        if (_plName == "") return;
        object? hooks = null;
        if (_plHooks.Trim() != "")
        { try { hooks = JsonDocument.Parse(_plHooks).RootElement.Clone(); } catch { return; } }
        await Api.PostAsync("api/plugins", new { name = _plName, enabled = true, hooks });
        _plName = ""; _plHooks = "";
        _plugins = await Api.GetAsync("api/plugins");
    }

    private async Task TogglePlugin(JsonElement p) =>
        await Api.PostAsync("api/plugins", new { id = p.GetProperty("id").GetString(), enabled = !(p.TryGetProperty("enabled", out var e) && e.GetBoolean()) });

    private async Task DelPlugin(string id)
    { await Api.DeleteAsync($"api/plugins/{id}"); _plugins = await Api.GetAsync("api/plugins"); }

    private async Task LoadRegTools() =>
        _regTools = (await Api.GetAsync("api/search-tools/registered")).GetProperty("tools").EnumerateArray().ToArray();

    private async Task AddRegTool()
    {
        if (_stName == "" || _stUrl == "") return;
        await Api.PostAsync("api/search-tools", new { name = _stName, kind = _stKind, url = _stUrl, enabled = true });
        _stName = ""; _stUrl = ""; await LoadRegTools();
    }

    private async Task ToggleRegTool(JsonElement t)
    { await Api.PostAsync("api/search-tools", new { id = t.GetProperty("id").GetString(), enabled = !(t.TryGetProperty("enabled", out var e) && e.GetBoolean()) }); await LoadRegTools(); }

    private async Task DelRegTool(string id)
    { await Api.DeleteAsync($"api/search-tools/{id}"); await LoadRegTools(); }
}
