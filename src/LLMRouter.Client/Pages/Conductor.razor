@page "/dashboard/conductor"
@page "/dashboard/orchestration"
@inject Api Api
@inject Loc Loc

<h1 class="page-title">@Loc.T("conductor.title", "Conductor")</h1>
<p class="page-desc">@Loc.T("conductor.subtitle", "Multi-step workflows — chain models, fan-out, merge outputs")</p>

<div class="grid" style="grid-template-columns:1fr 1fr;gap:12px">
    <div class="card card-p">
        <div class="flex" style="gap:8px;margin-bottom:8px">
            <input class="input" style="width:160px" @bind="_wfName" placeholder="workflow name" />
            <button class="btn btn-primary btn-sm" @onclick="Save">@Loc.T("common.save", "Save")</button>
            <select class="input" @bind="_wfName">
                <option value="">saved…</option>
                @foreach (var w in _saved) { <option value="@w">@w</option> }
            </select>
        </div>
        <textarea class="input" style="width:100%;height:200px;font-family:var(--mono);font-size:12px" @bind="_wfJson"></textarea>
        <input class="input" style="margin-top:8px" @bind="_input" placeholder="input text" />
        <button class="btn btn-primary btn-sm" style="margin-top:8px" @onclick="Run" disabled="@_busy">@Loc.T("conductor.run", "Run")</button>
    </div>
    <div class="card card-p">
        <h3 class="bold" style="margin:0 0 8px">@Loc.T("conductor.output", "Output")</h3>
        @if (_result is not null)
        {
            @foreach (var st in _result.Value.GetProperty("steps").EnumerateArray())
            {
                <div class="card-in" style="padding:8px;background:var(--surface-2);border-radius:9px;margin-bottom:8px">
                    <div class="flex between"><b>@st.GetProperty("name").GetString()</b><span class="muted xs">@st.GetProperty("model").GetString() · @st.GetProperty("ms").GetInt32()ms</span></div>
                    <pre style="white-space:pre-wrap;font-size:11px;margin:6px 0 0">@st.GetProperty("output").GetString()</pre>
                </div>
            }
            <b>@Loc.T("conductor.final", "Final")</b>
            <pre class="code-block" style="font-size:12px;white-space:pre-wrap">@_result.Value.GetProperty("final").GetString()</pre>
        }
        else { <p class="muted">…</p> }
    </div>
</div>

<h2 class="bold" style="margin-top:28px">@Loc.T("conductor.askTitle", "Ask the conductor")</h2>
<p class="page-desc">@Loc.T("conductor.askSubtitle", "Natural-language goal — the model decomposes it into steps and runs them")</p>
<div class="card card-p" style="margin-bottom:14px">
    <div class="flex" style="gap:8px;flex-wrap:wrap">
        <input class="input" style="width:180px" @bind="_askModel" placeholder="model (opt)" />
        <input class="input" style="flex:1;min-width:240px" @bind="_askGoal" placeholder="goal…" />
        <button class="btn btn-sm" @onclick="Ask" disabled="@_busy">@Loc.T("conductor.ask", "Ask")</button>
    </div>
    @if (_fleet is not null)
    {
        <p class="dim" style="font-size:12px;margin-top:8px">@_fleet</p>
    }
</div>

@if (_tasks is { Length: > 0 })
{
    <table class="table" style="font-size:13px">
        <thead><tr><th>goal</th><th>state</th><th>steps</th><th>created</th><th></th><th></th></tr></thead>
        <tbody>
        @foreach (var t in _tasks)
        {
            var st = t.GetProperty("state").GetString()!;
            var tid = t.GetProperty("id").GetString()!;
            <tr>
                <td style="max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@t.GetProperty("goal").GetString()</td>
                <td><span class="chip @(st == "done" ? "chip-green" : st is "failed" or "cancelled" ? "chip-red" : "chip-yellow")">@st</span></td>
                <td>@(t.GetProperty("steps").ValueKind == JsonValueKind.Object && t.GetProperty("steps").TryGetProperty("steps", out var sa) ? sa.GetArrayLength() : 0)</td>
                <td class="dim">@t.GetProperty("createdAt").GetString()</td>
                <td><button class="btn btn-sm" @onclick="() => _open = _open == tid ? null : tid">@(_open == tid ? "−" : "+")</button></td>
                <td>
                    @if (st is "queued" or "running")
                    {
                        <button class="btn btn-sm btn-danger" @onclick="() => CancelTask(tid)">@Loc.T("common.cancel", "Cancel")</button>
                    }
                </td>
            </tr>
            @if (_open == tid && t.TryGetProperty("result", out var res) && res.ValueKind == JsonValueKind.Object)
            {
                <tr><td colspan="6">
                    <pre class="code-block" style="font-size:12px;white-space:pre-wrap">@res.GetRawText()</pre>
                </td></tr>
            }
        }
        </tbody>
    </table>
}

@code {
    private string _wfName = "", _input = "";
    private string _askGoal = "", _askModel = "";
    private JsonElement[]? _tasks;
    private string? _fleet, _open;
    private string _wfJson = "{\n  \"name\": \"review\",\n  \"steps\": [\n    {\"name\": \"draft\", \"model\": \"combo-fast\", \"prompt\": \"Summarize: {{input}}\"},\n    {\"name\": \"critique\", \"fan\": [\"m1\", \"m2\"], \"prompt\": \"Critique: {{prev}}\", \"join\": \"merge\"}\n  ]\n}";
    private JsonElement? _result;
    private List<string> _saved = [];
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await LoadSaved();
        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        var r = await Api.GetAsync("api/conductor/tasks");
        _tasks = r.TryGetProperty("tasks", out var arr) ? arr.EnumerateArray().ToArray() : [];
        var f = await Api.GetAsync("api/conductor/fleet");
        if (f.TryGetProperty("workers", out var w))
            _fleet = $"workers: {w.GetArrayLength()} · a2a: {string.Join(", ", f.GetProperty("a2aQueue").EnumerateObject().Select(kv => $"{kv.Name}={kv.Value.GetInt32()}"))}";
    }

    private async Task Ask()
    {
        _busy = true;
        try
        {
            await Api.PostAsync("api/conductor/ask",
                new { goal = _askGoal, model = string.IsNullOrWhiteSpace(_askModel) ? (string?)null : _askModel });
            _askGoal = "";
            await LoadTasks();
        }
        finally { _busy = false; }
    }

    private async Task CancelTask(string id)
    {
        await Api.Raw.PostAsJsonAsync($"api/conductor/tasks/{id}/cancel", new { });
        await LoadTasks();
    }

    private async Task LoadSaved()
    {
        var r = await Api.GetAsync("api/conductor/workflows");
        _saved = r.TryGetProperty("workflows", out var a)
            ? a.EnumerateArray().Select(w => w.TryGetProperty("name", out var n) ? n.GetString()! : "").Where(x => x != "").ToList()
            : [];
    }

    private async Task Save()
    {
        await Api.PutAsync($"api/conductor/workflows/{Uri.EscapeDataString(_wfName)}",
            JsonSerializer.Deserialize<JsonElement>(_wfJson));
        await LoadSaved();
    }

    private async Task Run()
    {
        _busy = true;
        var r = await Api.Raw.PostAsJsonAsync("api/conductor/run",
            new { workflow = JsonSerializer.Deserialize<JsonElement>(_wfJson), input = _input });
        _result = r.IsSuccessStatusCode ? JsonSerializer.Deserialize<JsonElement>(await r.Content.ReadAsStringAsync()) : null;
        _busy = false;
    }
}
