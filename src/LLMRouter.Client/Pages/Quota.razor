@page "/dashboard/quota"
@inject Api Api
@inject Loc Loc

<h1 class="page-title">@Loc.T("quota.title", "Provider quota")</h1>
<p class="page-desc">@Loc.T("quota.subtitle", "Token caps per connection — exhausted connections are skipped by the cascade")</p>

@if (_quota is null)
{
    <p class="muted">…</p>
}
else
{
    <div class="card" style="overflow-x:auto">
        <table class="table">
            <thead><tr><th>Provider</th><th>Connection</th><th>Daily</th><th>Monthly</th><th>Status</th><th>Caps</th></tr></thead>
            <tbody>
                @foreach (var q in _quota)
                {
                    var daily = q.GetProperty("daily"); var monthly = q.GetProperty("monthly");
                    var cid = q.GetProperty("connectionId").GetString()!;
                    var exhausted = daily.GetProperty("exhausted").GetBoolean() || monthly.GetProperty("exhausted").GetBoolean();
                    <tr>
                        <td class="mono sm">@q.GetProperty("provider").GetString()</td>
                        <td>@q.GetProperty("name").GetString()</td>
                        <td class="mono sm">@daily.GetProperty("used").GetInt64() / @(daily.GetProperty("limit").ValueKind == JsonValueKind.Null ? "∞" : daily.GetProperty("limit").GetInt64().ToString())</td>
                        <td class="mono sm">@monthly.GetProperty("used").GetInt64() / @(monthly.GetProperty("limit").ValueKind == JsonValueKind.Null ? "∞" : monthly.GetProperty("limit").GetInt64().ToString())</td>
                        <td><span class="badge @(exhausted ? "err" : "ok")">@(exhausted ? "exhausted" : "ok")</span></td>
                        <td>
                            <div class="flex" style="gap:6px">
                                <input class="input" style="width:90px" type="number" placeholder="daily" value="@GetCap(cid, "quotaDaily")" @onchange='e => _caps[(cid, "quotaDaily")] = e.Value?.ToString()' />
                                <input class="input" style="width:90px" type="number" placeholder="monthly" value="@GetCap(cid, "quotaMonthly")" @onchange='e => _caps[(cid, "quotaMonthly")] = e.Value?.ToString()' />
                                <button class="btn btn-sm" @onclick="() => SaveCaps(cid)">@Loc.T("common.save", "Save")</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (_msg is not null) { <p class="sm muted mt-2">@_msg</p> }
}

@* ---- SPEC-041: quota plans + preview ---- *@
<div class="card card-p mt-4">
    <div class="flex between">
        <h3 style="margin:0">@Loc.T("quota.plans", "Plans")</h3>
        <div class="flex gap-2">
            <input class="input" style="width:130px" placeholder="@Loc.T("quota.planName", "Plan name")" @bind="_planName" />
            <input class="input" style="width:80px" type="number" placeholder="rpm" @bind="_planRpm" />
            <input class="input" style="width:100px" type="number" placeholder="dailyTokens" @bind="_planDaily" />
            <button class="btn btn-sm btn-primary" @onclick="CreatePlan">@Loc.T("quota.newPlan", "New plan")</button>
        </div>
    </div>
    @if (_plans.Count == 0)
    {
        <p class="muted sm mt-2">@Loc.T("quota.noPlans", "No plans — plans apply a bundle of limits to a key")</p>
    }
    else
    {
        <table class="table mt-2">
            <thead><tr><th>@Loc.T("keys.name", "Name")</th><th>@Loc.T("keys.limits", "Limits")</th><th>@Loc.T("quota.applyTo", "Apply to key")</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in _plans)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td class="mono sm muted">@p.Limits</td>
                        <td>
                            <select class="input" style="width:auto" @onchange="e => ApplyPlan(p, e.Value?.ToString())">
                                <option value="">@Loc.T("quota.pickKey", "pick key…")</option>
                                @foreach (var k in _keys)
                                {
                                    <option value="@k.Id">@k.Name</option>
                                }
                            </select>
                        </td>
                        <td><button class="btn btn-sm btn-danger" @onclick="() => DeletePlan(p)">Delete</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="card card-p mt-4">
    <h3 style="margin:0">@Loc.T("quota.preview", "Preview")</h3>
    <p class="muted sm">@Loc.T("quota.previewDesc", "Dry-run: would this key+model be allowed right now?")</p>
    <div class="flex gap-2 mt-2" style="flex-wrap:wrap;align-items:end">
        <div>
            <label class="muted sm">@Loc.T("quota.key", "Key")</label>
            <select class="input" @bind="_pvKey">
                @foreach (var k in _keys)
                {
                    <option value="@k.Id">@k.Name</option>
                }
            </select>
        </div>
        <div><label class="muted sm">model</label><input class="input" style="width:160px" @bind="_pvModel" /></div>
        <div><label class="muted sm">estTokens</label><input class="input" style="width:100px" type="number" @bind="_pvTokens" /></div>
        <button class="btn btn-sm btn-primary" @onclick="Preview">@Loc.T("quota.check", "Check")</button>
    </div>
    @if (_pv is not null)
    {
        <p class="mt-2 sm">
            <span class="badge @(_pvAllow ? "ok" : "err")">@(_pvAllow ? "allow" : "deny")</span>
            <span class="muted"> @_pv</span>
        </p>
    }
</div>

@code {
    private List<JsonElement>? _quota;
    private string? _msg;
    private readonly Dictionary<(string, string), string?> _caps = new();
    private Dictionary<string, JsonElement> _connData = new();

    private string? GetCap(string cid, string key) =>
        _caps.TryGetValue((cid, key), out var v) ? v
            : _connData.TryGetValue(cid, out var d) && d.TryGetProperty(key, out var x) && x.ValueKind == JsonValueKind.Number
                ? x.GetInt64().ToString() : "";

    protected override async Task OnInitializedAsync()
    {
        var r = await Api.GetAsync("api/quota");
        _quota = r.GetProperty("quota").EnumerateArray().Select(x => x.Clone()).ToList();
        var conns = await Api.GetAsync("api/provider-connections");
        foreach (var c in conns.GetProperty("connections").EnumerateArray())
            _connData[c.GetProperty("id").GetString()!] = JsonDocument.Parse(c.GetProperty("data").GetString()!).RootElement.Clone();
        await LoadPlans();
    }

    // ---- SPEC-041 state ----
    private sealed class P { public string Id = ""; public string Name = ""; public string Limits = "{}"; }
    private List<P> _plans = [];
    private List<(string Id, string Name)> _keys = [];
    private string _planName = "";
    private int _planRpm, _planDaily;
    private string _pvKey = "", _pvModel = "", _pv = "";
    private int _pvTokens;
    private bool _pvAllow;

    private async Task LoadPlans()
    {
        var r = await Api.GetAsync("api/quota/plans");
        _plans = r.TryGetProperty("plans", out var pa)
            ? pa.EnumerateArray().Select(x => new P
            {
                Id = x.GetProperty("id").GetString() ?? "",
                Name = x.GetProperty("name").GetString() ?? "",
                Limits = x.TryGetProperty("limitsJson", out var lj) ? lj.GetString() ?? "{}" : "{}",
            }).ToList() : [];
        var kr = await Api.GetAsync("api/keys");
        _keys = kr.TryGetProperty("keys", out var ka)
            ? ka.EnumerateArray().Select(k => (k.GetProperty("id").GetString() ?? "",
                k.TryGetProperty("name", out var n) ? n.GetString() ?? "" : "")).ToList() : [];
        if (_keys.Count > 0 && _pvKey.Length == 0) _pvKey = _keys[0].Id;
    }

    private async Task CreatePlan()
    {
        if (string.IsNullOrWhiteSpace(_planName)) return;
        var limits = new Dictionary<string, int>();
        if (_planRpm > 0) limits["rpm"] = _planRpm;
        if (_planDaily > 0) limits["dailyTokens"] = _planDaily;
        await Api.PostAsync("api/quota/plans", new { name = _planName, limits });
        _planName = ""; _planRpm = _planDaily = 0;
        await LoadPlans();
    }

    private async Task ApplyPlan(P p, string? keyId)
    {
        if (string.IsNullOrEmpty(keyId)) return;
        await Api.PostAsync($"api/keys/{keyId}/plan", new { planId = p.Id });
        _msg = "✓";
    }

    private async Task DeletePlan(P p) { await Api.DeleteAsync($"api/quota/plans/{p.Id}"); await LoadPlans(); }

    private async Task Preview()
    {
        var r = await Api.PostAsync("api/quota/preview", new { keyId = _pvKey, model = _pvModel, estTokens = _pvTokens });
        _pvAllow = r.TryGetProperty("allow", out var a) && a.GetBoolean();
        var reasons = r.TryGetProperty("reasons", out var rs)
            ? string.Join("; ", rs.EnumerateArray().Select(x => x.GetString())) : "";
        var used = r.TryGetProperty("dailyUsed", out var du) ? du.GetInt64() : 0;
        var cap = r.TryGetProperty("dailyCap", out var dc) && dc.ValueKind == JsonValueKind.Number ? dc.GetInt32().ToString() : "∞";
        _pv = $"daily {used}/{cap}" + (reasons.Length > 0 ? $" — {reasons}" : "");
    }

    private async Task SaveCaps(string cid)
    {
        var d = _connData[cid].EnumerateObject().ToDictionary(k => k.Name, k => k.Value.Clone());
        foreach (var key in new[] { "quotaDaily", "quotaMonthly" })
        {
            var v = GetCap(cid, key);
            if (long.TryParse(v, out var n) && n > 0) d[key] = JsonSerializer.SerializeToElement(n);
            else d.Remove(key);
        }
        await Api.PutAsync($"api/provider-connections/{cid}", new { data = d });
        _connData[cid] = JsonSerializer.SerializeToElement(d);
        _msg = "✓";
        await OnInitializedAsync();
    }
}
