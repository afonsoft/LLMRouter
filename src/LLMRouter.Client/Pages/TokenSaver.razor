@page "/dashboard/token-saver"
@page "/dashboard/context/rtk"
@inject Api Api
@inject Loc Loc

<h1 class="page-title">@Loc.T("tokenSaver.title", "Token saver")</h1>
<p class="page-desc">@Loc.T("tokenSaver.subtitle", "Lightweight prompt compression before upstream calls")</p>

@if (_data is null)
{
    <p class="muted">…</p>
}
else
{
    <div class="grid grid-2">
        <div class="card card-p">
            <h3 class="bold" style="margin:0 0 14px">@Loc.T("tokenSaver.settings", "Compression")</h3>
            <div class="flex between">
                <span class="sm">@Loc.T("tokenSaver.enabled", "Enable token saver")</span>
                <input type="checkbox" checked="@Enabled" @onchange='e => Set("enabled", (bool)(e.Value ?? false))' />
            </div>
            <div class="flex between mt-3">
                <span class="sm">@Loc.T("tokenSaver.whitespace", "Collapse whitespace runs")</span>
                <input type="checkbox" checked="@Get("whitespace", true)" @onchange='e => Set("whitespace", (bool)(e.Value ?? false))' />
            </div>
            <div class="flex between mt-3">
                <span class="sm">@Loc.T("tokenSaver.dedup", "Dedup consecutive identical lines")</span>
                <input type="checkbox" checked="@Get("dedup", true)" @onchange='e => Set("dedup", (bool)(e.Value ?? false))' />
            </div>
            <div class="mt-4" style="border-top:1px solid var(--border);padding-top:10px">
                <h4 class="bold xs muted" style="margin:0 0 8px">RTK filters</h4>
                @if (_filters is not null)
                {
                    @foreach (var f in _filters)
                    {
                        <div class="flex between mt-2">
                            <span class="xs">@f.GetProperty("name").GetString() <span class="muted">— @f.GetProperty("desc").GetString()</span></span>
                            <input type="checkbox" checked="@FilterOn(f.GetProperty("name").GetString()!)" @onchange='e => ToggleFilter(f.GetProperty("name").GetString()!, (bool)(e.Value ?? false))' />
                        </div>
                    }
                    <div class="flex between mt-3">
                        <span class="xs">maxLineLength</span>
                        <input class="inp xs" type="number" style="width:80px" @bind="_maxLine" />
                    </div>
                    <div class="mt-3"><span class="xs muted">compressRoles (csv)</span><input class="inp xs mono" style="width:100%" @bind="_roles" /></div>
                    <div class="mt-2"><span class="xs muted">skipRules (regex, um por linha)</span><textarea class="inp xs mono" style="width:100%" rows="2" @bind="_skip"></textarea></div>
                    <div class="mt-2"><span class="xs muted">preservePatterns (regex, um por linha)</span><textarea class="inp xs mono" style="width:100%" rows="2" @bind="_preserve"></textarea></div>
                }
            </div>
            <button class="btn btn-primary btn-sm mt-4" @onclick="Save">@Loc.T("common.save", "Save")</button>
            @if (_msg is not null) { <span class="sm muted" style="margin-left:8px">@_msg</span> }
        </div>
        <div class="card card-p">
            <h3 class="bold" style="margin:0 0 14px">@Loc.T("tokenSaver.stats", "Savings")</h3>
            <div style="font-size:32px;font-weight:700;color:var(--primary)">@_tokensSaved</div>
            <div class="sm text2">@Loc.T("tokenSaver.saved", "tokens saved")</div>
            <div class="sm muted mt-3">@_requestsCompressed requests compressed</div>
        </div>
    </div>
}

@code {
    private Dictionary<string, JsonElement>? _data;
    private long _tokensSaved;
    private int _requestsCompressed;
    private string? _msg;

    private bool Enabled => Get("enabled");
    private JsonElement[]? _filters;
    private HashSet<string> _on = [];
    private int _maxLine = 500;
    private string _roles = "system,user,assistant", _skip = "", _preserve = "";
    private bool FilterOn(string n) => _on.Contains(n);
    private void ToggleFilter(string n, bool on) { if (on) _on.Add(n); else _on.Remove(n); }
    private bool Get(string k, bool def = false) =>
        _data!.TryGetValue(k, out var v) && v.ValueKind is JsonValueKind.True or JsonValueKind.False ? v.GetBoolean() : def;
    private void Set(string k, bool v) => _data![k] = JsonSerializer.SerializeToElement(v);

    protected override async Task OnInitializedAsync()
    {
        var s = await Api.GetAsync("api/settings");
        if (s.TryGetProperty("data", out var d) && d.ValueKind == JsonValueKind.Object
            && d.TryGetProperty("tokenSaver", out var ts) && ts.ValueKind == JsonValueKind.Object)
            _data = ts.EnumerateObject().ToDictionary(k => k.Name, k => k.Value.Clone());
        _data ??= [];
        if (_data.TryGetValue("filters", out var fa) && fa.ValueKind == JsonValueKind.Array)
            _on = fa.EnumerateArray().Select(x => x.GetString() ?? "").Where(x => x != "").ToHashSet();
        else _on = new() { "collapseWhitespace", "dedupLines", "dropEmptyLines" };
        if (_data.TryGetValue("maxLineLength", out var ml) && ml.TryGetInt32(out var mi)) _maxLine = mi;
        if (_data.TryGetValue("compressRoles", out var cr) && cr.ValueKind == JsonValueKind.Array)
            _roles = string.Join(",", cr.EnumerateArray().Select(x => x.GetString()));
        if (_data.TryGetValue("skipRules", out var sr) && sr.ValueKind == JsonValueKind.Array)
            _skip = string.Join("\n", sr.EnumerateArray().Select(x => x.GetString()));
        if (_data.TryGetValue("preservePatterns", out var pp) && pp.ValueKind == JsonValueKind.Array)
            _preserve = string.Join("\n", pp.EnumerateArray().Select(x => x.GetString()));
        try
        {
            var cat = await Api.GetAsync("api/token-saver/filters");
            _filters = cat.GetProperty("filters").EnumerateArray().ToArray();
        }
        catch { }
        try
        {
            var st = await Api.GetAsync("api/token-saver/stats");
            _tokensSaved = st.GetProperty("tokensSaved").GetInt64();
            _requestsCompressed = st.GetProperty("requestsCompressed").GetInt32();
        }
        catch { }
    }

    private async Task Save()
    {
        await Api.PutAsync("api/settings", new { tokenSaver = _data });
        await Api.PostAsync("api/token-saver/filters", new
        {
            filters = _on.ToArray(),
            maxLineLength = _maxLine,
            compressRoles = _roles.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
            skipRules = _skip.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
            preservePatterns = _preserve.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
        });
        _msg = "✓";
    }
}
